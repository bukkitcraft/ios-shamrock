+/*
+ * Kernel environment injection for iOS system daemons (backboardd, SpringBoard)
+ * launchd refuses to pass DYLD_* variables from plists and panics if binaries
+ * are replaced with non-platform wrappers.
+ * By injecting DYLD_INSERT_LIBRARIES directly inside exec_extract_strings,
+ * stock Apple platform binaries remain untouched, keeping valid signatures and entitlements,
+ * while transparently loading our OpenGL ES / Freedreno GPU stack.
+ */
+static char exec_inject_conf[512] = "/usr/lib/libshamrock-inject.dylib backboardd SpringBoard";
+SYSCTL_STRING(_kern, OID_AUTO, exec_inject, CTLFLAG_RW | CTLFLAG_LOCKED, exec_inject_conf, sizeof(exec_inject_conf),
+    "LIBRARY NAME... [; LIBRARY NAME...]: programs started with the library inserted");
+
+static bool
+exec_inject_env(struct image_params *imgp, char *env, size_t size)
+{
+	static bool bootarg_checked = false;
+	if (!bootarg_checked) {
+		bootarg_checked = true;
+		char bootarg[512] = "";
+		if (PE_parse_boot_argn("exec_inject", bootarg, sizeof(bootarg))) {
+			strlcpy(exec_inject_conf, bootarg, sizeof(exec_inject_conf));
+		}
+	}
+
+	const char *name, *p = exec_inject_conf;
+	size_t namelen, used;
+	bool any = false;
+
+	if (*p == 0 || imgp->ip_ndp == NULL) {
+		return false;
+	}
+	name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+	namelen = imgp->ip_ndp->ni_cnd.cn_namelen;
+	used = strlcpy(env, "DYLD_INSERT_LIBRARIES=", size);
+	while (*p != 0) {
+		const char *library;
+		size_t liblen;
+		bool matched = false;
+
+		while (*p == ' ' || *p == ';') {
+		p++;
+		}
+		library = p;
+		while (*p != 0 && *p != ' ' && *p != ';') {
+		p++;
+		}
+		liblen = (size_t)(p - library);
+		while (*p == ' ') {
+			const char *word = ++p;
+
+			while (*p != 0 && *p != ' ' && *p != ';') {
+				p++;
+			}
+			if (!matched && (size_t)(p - word) == namelen && namelen != 0 && liblen != 0 &&
+			    strncmp(word, name, namelen) == 0) {
+				matched = true;
+			}
+		}
+		if (matched && liblen != 0 && used + 1 + liblen < size) {
+			if (any) {
+				env[used++] = ':';
+			}
+			memcpy(env + used, library, liblen);
+			used += liblen;
+			env[used] = 0;
+			any = true;
+		}
+	}
+	return any;
+}
