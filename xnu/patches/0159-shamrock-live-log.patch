+/*
+ * shamrock live log: every 3 s the tail of the kernel message buffer is copied into the same RAM
+ * region (SWEETDUMP header, "LIVE" line, last 96 KB of MSGBUF, END), so any boot can be read from lk2nd after a
+ * reset (readdump.sh), without a separate log image. Off with sweetlivelog=0. The stall dump takes
+ * the region over for good when it fires.
+ */
+static volatile int s_region_busy;
+static volatile bool s_fired;
+
+static void
+s_region_take(void)
+{
+	while (!__sync_bool_compare_and_swap(&s_region_busy, 0, 1)) {
+	}
+}
+
+static void
+s_region_give(void)
+{
+	__sync_lock_release(&s_region_busy);
+}
+
+static void
+s_msgbuf_tail(int max)
+{
+	if (msgbufp && msgbufp->msg_magic == MSG_MAGIC && msgbufp->msg_bufc && msgbufp->msg_size > 0) {
+		int size = msgbufp->msg_size;
+		int n = size < max ? size : max;
+		int x = msgbufp->msg_bufx;
+		s_s("MSGBUF\n");
+		for (int i = n; i > 0; i--) {
+			int idx = (x - i) % size;
+			if (idx < 0) {
+				idx += size;
+			}
+			char c = msgbufp->msg_bufc[idx];
+			if (c == '\n' || (c >= 0x20 && c < 0x7f)) {
+				s_c(c);
+			}
+		}
+		s_s("\n");
+	}
+}
+
+static void
+s_finish(void)
+{
+	s_s("END\n");
+	const char *m = "SWEETDUMP";
+	for (int i = 0; i < 9; i++) {
+		sbuf[i] = m[i];
+	}
+	*(volatile uint32_t *)(sbuf + 12) = spos;
+	__builtin_arm_dsb(DSB_SY);
+}
+
+static thread_call_t s_live_call;
+static vm_offset_t s_live_va;
+
+static void
+sweet_live_fire(thread_call_param_t p0, thread_call_param_t p1)
+{
+#pragma unused(p0, p1)
+	if (s_fired) {
+		return;
+	}
+	if (!s_live_va) {
+		s_live_va = ml_io_map(STALL_PA, STALL_SIZE);
+		if (!s_live_va) {
+			return;
+		}
+	}
+	s_region_take();
+	if (!s_fired) {
+		sbuf = (char *)s_live_va;
+		spos = 0;
+		s_s("LIVE now=");
+		s_x(mach_absolute_time());
+		s_c('\n');
+		s_msgbuf_tail(96 * 1024);     /* ~10 ms of uncached byte stores every 3 s */
+		s_finish();
+	}
+	s_region_give();
+	uint64_t deadline;
+	nanoseconds_to_deadline(3ULL * NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(s_live_call, deadline);
+}
+
 static void
 sweet_stall_fire(thread_call_param_t p0, thread_call_param_t p1)
 {
