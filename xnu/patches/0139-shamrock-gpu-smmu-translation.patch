+		IOLog("SWEET A405: SCM SMC64 probe %lld, SMC32 probe %lld (avail %llu)\n", st, st32, avail);
+		if (st32 != 0) {
+			IOLog("SWEET A405: no usable SCM convention: GPU SMMU left in bypass\n");
+			return false;
+		}
+		smc64 = false;
+	}
