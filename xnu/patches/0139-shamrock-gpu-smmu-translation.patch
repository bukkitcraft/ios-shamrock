+#define CB_SCTLR        0x00
+#define CB_TCR2         0x10
+#define CB_TTBR0        0x20
+#define CB_TTBR1        0x28
+#define CB_TCR          0x30
+#define CB_MAIR0        0x38
+#define CB_MAIR1        0x3c
+#define CB_FSR          0x58
+#define CB_FAR          0x60
+#define CB_FSYNR0       0x68
+#define CB_TLBIASID     0x610
+#define CB_TLBSYNC      0x7f0
+#define CB_TLBSTATUS    0x7f4
+#define PTE_ATTRS       ((1ULL << 11) | (1ULL << 10) | (2ULL << 8) | (1ULL << 6))      /* nG AF SH-outer AP-user, AttrIndx 0 (NC) */
+#define PTE_RO          (2ULL << 6)
+#define GPU_VA_BASE     0x01000000ULL
+#define GPU_VA_END      0x41000000ULL                   /* 1 GiB of GPU addresses for buffers */
+#define GPU_VA_GRAIN    0x10000ULL                      /* allocator granule: 64 KiB */
+#define GPU_VA_GRAINS   ((GPU_VA_END - GPU_VA_BASE) / GPU_VA_GRAIN)
+#define GMMU_L3_TABLES  ((GPU_VA_END - GPU_VA_BASE) >> 21)  /* 512: one per 2 MiB of buffer addresses */
+#define GMMU_TABLES     (1 + 4 + GMMU_L3_TABLES)        /* L1, the four L2s, the L3s */
+
+static uint64_t g_gmmu[GMMU_TABLES][512] __attribute__((aligned(4096)));
+static uint64_t g_gmmu_pa;
+static uint32_t g_gmmu_l3_used;
+static uint16_t g_gmmu_l3_of[GMMU_L3_TABLES];          /* L3 table index + 1 for each 2 MiB of buffer addresses */
