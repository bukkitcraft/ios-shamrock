+uint64_t
+hakios_gpu_address(uint64_t size)
+{
+	uint64_t n = (size + GPU_VA_GRAIN - 1) / GPU_VA_GRAIN;
+	uint64_t run = 0;
+
+	if (!g_smmu_on || n == 0) {
+		return 0;
+	}
+	for (uint64_t i = 0; i < GPU_VA_GRAINS; i++) {
+		if (g_gpu_va_map[i / 8] & (1u << (i % 8))) {
+			run = 0;
+			continue;
+		}
+		if (++run == n) {
+			uint64_t first = i + 1 - n;
+			for (uint64_t j = first; j <= i; j++) {
+				g_gpu_va_map[j / 8] |= (uint8_t)(1u << (j % 8));
+			}
+			return GPU_VA_BASE + first * GPU_VA_GRAIN;
+		}
+	}
+	return 0;
+}
+
+void
+hakios_gpu_address_free(uint64_t address, uint64_t size)
+{
+	if (address < GPU_VA_BASE || address >= GPU_VA_END) {
+		return;                 /* (a physical address from bypass mode) */
+	}
+	uint64_t first = (address - GPU_VA_BASE) / GPU_VA_GRAIN;
+	uint64_t n = (size + GPU_VA_GRAIN - 1) / GPU_VA_GRAIN;
+	for (uint64_t j = first; j < first + n && j < GPU_VA_GRAINS; j++) {
+		g_gpu_va_map[j / 8] &= (uint8_t)~(1u << (j % 8));
+	}
+}
+
+bool
+hakios_gpu_map(uint64_t address, uint64_t phys, bool read_only)
+{
+	if (!g_smmu_on || address < GPU_VA_BASE || address >= GPU_VA_END || (address & 0xfff) || (phys & 0xfff)) {
+		return false;
+	}
+	uint64_t *l3 = gmmu_l3(address, true);
+	if (l3 == NULL) {
+		return false;
+	}
+	uint64_t *pte = &l3[(address >> 12) & 511];
+	*pte = phys | PTE_ATTRS | (read_only ? PTE_RO : 0) | 3;
+	gmmu_dirty(pte, 8);
+	return true;
+}
+
+void
+hakios_gpu_mapped(void)
+{
+	if (g_smmu_on) {
+		gmmu_sync();
+	}
+}
+
+void
+hakios_gpu_unmap(uint64_t address, uint64_t size)
+{
+	if (!g_smmu_on || address < GPU_VA_BASE || address >= GPU_VA_END) {
+		return;
+	}
+	for (uint64_t o = 0; o < size && address + o < GPU_VA_END; o += 4096) {
+		uint64_t *l3 = gmmu_l3(address + o, false);
+		if (l3 != NULL) {
+			uint64_t *pte = &l3[((address + o) >> 12) & 511];
+			*pte = 0;
+			gmmu_dirty(pte, 8);
+		}
+	}
+	gmmu_sync();
+}
