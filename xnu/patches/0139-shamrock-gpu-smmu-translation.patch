+static void
+gmmu_off(const char *why)
+{
+	if (!g_smmu_on) {
+		return;
+	}
+	IOLog("SWEET A405: GPU SMMU off again (%s): FSR %#x FAR %#x%08x FSYNR0 %#x\n", why,
+	    cb_read(CB_FSR), cb_read(CB_FAR + 4), cb_read(CB_FAR), cb_read(CB_FSYNR0));
+	cb_write(CB_SCTLR, 0);
+	cb_write(CB_FSR, cb_read(CB_FSR));
+	__builtin_arm_dsb(0xf);
+	g_smmu_on = false;
+	g_ring_gpu = g_ring_phys;
+	g_fence_gpu = g_fence_phys;
+}
