+static inline void cb_write(uint32_t off, uint32_t v) { g_cb0[off / 4] = v; }
+static inline uint32_t cb_read(uint32_t off) { return g_cb0[off / 4]; }
+
+/* Qualcomm SCM call as qcom_scm-smc.c (SMCCC standard call, SIP owner); x0 == 1: interrupted, again. */
+static int64_t
+sweet_scm(bool smc64, uint32_t svc, uint32_t cmd, uint64_t arginfo, uint64_t a0, uint64_t a1, uint64_t *r1)
+{
+	register uint64_t x0 __asm__("x0") = (smc64 ? 0x42000000ULL : 0x02000000ULL) | ((svc & 0xff) << 8) | (cmd & 0xff);
+	register uint64_t x1 __asm__("x1") = arginfo;
+	register uint64_t x2 __asm__("x2") = a0;
+	register uint64_t x3 __asm__("x3") = a1;
+	register uint64_t x4 __asm__("x4") = 0;
+	register uint64_t x5 __asm__("x5") = 0;
+	do {
+		__asm__ volatile ("smc #0"
+		    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5)
+		    :
+		    : "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	} while (x0 == 1);
+	if (r1) {
+		*r1 = x1;
+	}
+	return (int64_t)x0;
+}
+
+static void
+gmmu_dirty(void *p, size_t n)
+{
+	uint64_t a = (uint64_t)p;
+	if (a < g_gmmu_dirty_lo) g_gmmu_dirty_lo = a;
+	if (a + n > g_gmmu_dirty_hi) g_gmmu_dirty_hi = a + n;
+}
+
+static void
+gmmu_sync(void)
+{
+	if (g_gmmu_dirty_hi > g_gmmu_dirty_lo) {
+		flush_dcache64(g_gmmu_dirty_lo, (unsigned)(g_gmmu_dirty_hi - g_gmmu_dirty_lo), 0);
+	}
+	g_gmmu_dirty_lo = ~0ULL;
+	g_gmmu_dirty_hi = 0;
+	__builtin_arm_dsb(0xf);
+	cb_write(CB_TLBIASID, 0);
+	cb_write(CB_TLBSYNC, 0);
+	__builtin_arm_dsb(0xf);
+	for (int i = 0; i < 1000 && (cb_read(CB_TLBSTATUS) & 1); i++) {
+		delay(1);
+	}
+}
+
+static uint64_t *
+gmmu_l3(uint64_t va, bool make)
+{
+	uint32_t slot = (uint32_t)((va - GPU_VA_BASE) >> 21);
+	if (g_gmmu_l3_of[slot] == 0) {
+		if (!make || g_gmmu_l3_used >= GMMU_L3_TABLES) {
+			return NULL;
+		}
+		uint32_t t = 5 + g_gmmu_l3_used++;
+		g_gmmu_l3_of[slot] = (uint16_t)(t + 1);
+		uint64_t *l2 = g_gmmu[1 + (va >> 30)];
+		l2[(va >> 21) & 511] = (g_gmmu_pa + (uint64_t)t * 4096) | 3;     /* table */
+		gmmu_dirty(&l2[(va >> 21) & 511], 8);
+	}
+	return g_gmmu[g_gmmu_l3_of[slot] - 1];
+}
