diff --git c/osfmk/arm64/arm_vm_init.c w/osfmk/arm64/arm_vm_init.c
index 4b74d46..dc0398f 100644
--- c/osfmk/arm64/arm_vm_init.c
+++ w/osfmk/arm64/arm_vm_init.c
@@ -1851,7 +1851,7 @@ sweet_early_map_final(void)
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
 	for (unsigned int i = 0; i < SWEET_EARLY_FB_BLOCKS; i++) {
 		assert(slot[i] == ARM_TTE_EMPTY);
-		slot[i] = (0x9c000000ULL + (uint64_t)i * ARM_TT_L2_SIZE) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		slot[i] = ((uint64_t)SWEET_FB_PHYS + (uint64_t)i * ARM_TT_L2_SIZE) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
diff --git c/osfmk/arm64/start.s w/osfmk/arm64/start.s
index 80c19c9..280693e 100644
--- c/osfmk/arm64/start.s
+++ w/osfmk/arm64/start.s
@@ -515,10 +515,10 @@ LEXT(start_first_cpu)
 
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	MOV64	x0, (SWEET_FB_PHYS + (SWEET_FB_H - 32) * SWEET_FB_STRIDE)
 	mov		w1, #-1
 	mov		x2, #32
-	mov		x4, #4320
+	mov		x4, #SWEET_FB_STRIDE
 Lsweet_mark_row:
 	mov		x3, #64
 	mov		x5, x0
@@ -686,7 +686,7 @@ Lkernelcache_base_found:
 	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0x9c000000
+	MOV64	x10, SWEET_FB_PHYS
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
diff --git c/osfmk/arm64/sweet_early.c w/osfmk/arm64/sweet_early.c
