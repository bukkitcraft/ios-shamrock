diff --git c/osfmk/arm64/arm_vm_init.c w/osfmk/arm64/arm_vm_init.c
index 06bb568..b0f7d45 100644
--- c/osfmk/arm64/arm_vm_init.c
+++ w/osfmk/arm64/arm_vm_init.c
@@ -1837,16 +1837,18 @@ static void
 sweet_early_map_final(void)
 {
 	const vm_map_address_t va = SWEET_EARLY_FB_VA;
-	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
+	assert(va + SWEET_EARLY_FB_BLOCKS * ARM_TT_L2_SIZE <= gVirtBase);
 	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
 	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
-	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
-	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
-	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
-	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	for (unsigned int i = 0; i < SWEET_EARLY_FB_BLOCKS; i++) {
+		assert(slot[i] == ARM_TTE_EMPTY);
+		slot[i] = (0x9c000000ULL + (uint64_t)i * ARM_TT_L2_SIZE) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
 #endif
diff --git c/osfmk/arm64/start.s w/osfmk/arm64/start.s
index 023086f..80c19c9 100644
--- c/osfmk/arm64/start.s
+++ w/osfmk/arm64/start.s
@@ -692,7 +692,13 @@ Lkernelcache_base_found:
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
-	str		x11, [x13, x12, lsl #TTE_SHIFT]
+	mov		x16, #(SWEET_EARLY_FB_BLOCKS)
+	mov		x17, #(1 << ARM_TT_L2_SHIFT)
+1:	str		x11, [x13, x12, lsl #TTE_SHIFT]
+	add		x11, x11, x17
+	add		x12, x12, #1
+	subs		x16, x16, #1
+	b.ne		1b
 #endif
 
 	/* Ensure TTEs are visible */
diff --git c/pexpert/pexpert/arm64/SWEET.h w/pexpert/pexpert/arm64/SWEET.h
index b5d597e..2b480a8 100644
--- c/pexpert/pexpert/arm64/SWEET.h
+++ w/pexpert/pexpert/arm64/SWEET.h
@@ -39,6 +39,9 @@
 
 #define HAS_GIC_V3                1
 
+/* shamrock: 4K pages -> 2MB L2 blocks; the early framebuffer needs several (QEMU 1080x2400x4 = 10.4MB -> 6) */
+#define SWEET_EARLY_FB_BLOCKS     6
+
 #ifndef ASSEMBLER
 #define PLATFORM_PANIC_LOG_DISABLED
 #endif /* ! ASSEMBLER */
