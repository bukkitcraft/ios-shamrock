--- c/bsd/dev/sweet_emmc.c
+++ w/bsd/dev/sweet_emmc.c
@@ -47,6 +47,7 @@ static struct {
 	vm_offset_t dma;                   /* kernel VA of the DMA allocation (ADMA2 table + bounce) */
 	uint64_t dma_pa;
 	bool dma_ok;
+	uint64_t stat_bytes, stat_ticks, stat_next;   /* ADMA read throughput */
 } se;
 
 #define DMA_TABLE       0x0000          /* ADMA2 descriptors, 16 x 8 bytes used */
@@ -558,7 +559,16 @@ sweet_emmc_strategy(buf_t bp)
 		if (is_read && se.dma_ok) {
 			uint32_t w = MIN(count - done, DMA_BYTES - skip);
 			uint32_t nsec = (skip + w + 511) / 512;
+			uint64_t ts = mach_absolute_time();
 			error = emmc_dma_read((uint32_t)(se.first_block + lba), nsec);
+			se.stat_ticks += mach_absolute_time() - ts;
+			se.stat_bytes += (uint64_t)nsec * 512;
+			if (se.stat_bytes >= se.stat_next) {
+				uint64_t us = se.stat_ticks * 10ULL / 192ULL;
+				printf("SWEET EMMC: %llu MiB read, %llu KiB/s avg while reading\n", se.stat_bytes >> 20,
+				    us ? (se.stat_bytes * 1000000ULL / us) >> 10 : 0);
+				se.stat_next = se.stat_bytes + (32ULL << 20);
+			}
 			if (error) {
 				/* DMA path failed: log once, fall back to PIO for good */
 				printf("SWEET EMMC: ADMA read failed (%d, int 0x%x), using PIO\n", error, last_int);
