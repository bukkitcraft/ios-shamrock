+/* CPU speed probe: a 3-instruction loop (add, subs, b.ne) timed with the 19.2 MHz architected counter.
+ * ~1 iteration per cycle on a Cortex-A53, so iterations/us is roughly the core clock in MHz. */
+static void
+sweet_cpu_bench(void)
+{
+	uint64_t n = 20000000ULL, x = 0;
+	uint64_t t0 = mach_absolute_time();
+	__asm__ volatile ("1: add %0, %0, #1\n\tsubs %1, %1, #1\n\tb.ne 1b" : "+r"(x), "+r"(n) : : "cc");
+	uint64_t dt = mach_absolute_time() - t0;
+	uint64_t us = dt * 10ULL / 192ULL;     /* 19.2 MHz ticks -> microseconds */
+	printf("SWEET BENCH: 20000000 loop iterations in %llu us (~%llu iterations/us)\n", us, us ? 20000000ULL / us : 0);
+}
+
