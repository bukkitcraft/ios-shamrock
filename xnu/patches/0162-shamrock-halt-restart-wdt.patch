+/*
+ * shamrock: iOS halt / restart (slide to power off, reboot(2) from launchd) never ended: the phone sat
+ * on the shutdown spinner. Both now reset through the watchdog into lk2nd.
+ */
+int
+SweetPlatformExpert::haltRestart(unsigned int type)
+{
+	if (type != kPEHaltCPU && type != kPERestartCPU && type != kPEUPSDelayHaltCPU) {
+		return IODTPlatformExpert::haltRestart(type);   /* panic, paging off, ...: unchanged */
+	}
+	IOLog("SWEET: haltRestart(%u): resetting into lk2nd\n", type);
+	sweet_wdt_reset();
+	for (;;) {
+		__builtin_arm_wfe();
+	}
+	return 0;
+}
