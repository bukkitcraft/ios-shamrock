+/*
+ * shamrock: halt / restart from iOS (launchd's reboot(2) after "slide to power off"): one last live
+ * log snapshot, then an APSS watchdog bite in ~30 ms. The phone comes back in lk2nd (no PMIC power
+ * off yet); the log of the session can still be read there.
+ */
+void sweet_wdt_reset(void);
+void
+sweet_wdt_reset(void)
+{
+	if (!s_fired) {
+		if (!s_live_va) {
+			s_live_va = ml_io_map(STALL_PA, STALL_SIZE);
+		}
+		if (s_live_va && __sync_bool_compare_and_swap(&s_region_busy, 0, 1)) {
+			sbuf = (char *)s_live_va;
+			spos = 0;
+			s_s("LIVE (halt/restart) now=");
+			s_x(mach_absolute_time());
+			s_c('\n');
+			s_msgbuf_tail(96 * 1024);
+			s_finish();
+			s_fired = true;
+			s_region_give();
+		}
+	}
+	volatile uint32_t *w = (volatile uint32_t *)ml_io_map(STALL_WDT, 0x1000);
+	if (w) {
+		w[2] = 0;
+		w[1] = 1;
+		w[4] = 1000;
+		w[5] = 1000;            /* bite after ~30 ms at 32.768 kHz */
+		w[2] = 1;
+		__builtin_arm_dsb(DSB_SY);
+	}
+}
