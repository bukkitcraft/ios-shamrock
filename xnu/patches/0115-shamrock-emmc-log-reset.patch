 	}
 	for (uint32_t i = 0; i < nent; i += 4) {
@@ -313,7 +352,7 @@ emmc_find_partition(const char *want)
 			return 0;
 		}
 	}
-	printf("SWEET EMMC: no GPT partition named \"%s\"\n", want);
+	ELOG("SWEET EMMC: no GPT partition named \"%s\"\n", want);
 	return ENOENT;
 }
 
@@ -476,6 +515,8 @@ sweet_emmc_init(void)
 	}
 	lck_mtx_unlock(&sweet_emmc_lock);
 	if (error) {
+		ELOG("SWEET EMMC: init error %d -> dumping log and resetting\n", error);
