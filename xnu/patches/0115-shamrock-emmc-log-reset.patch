diff --git c/bsd/dev/sweet_emmc.c w/bsd/dev/sweet_emmc.c
index 69a43c4..db3587b 100644
--- c/bsd/dev/sweet_emmc.c
+++ w/bsd/dev/sweet_emmc.c
@@ -42,6 +42,42 @@ static struct {
 	uint64_t total_sectors;
 } se;
 
+/* init log kept in RAM; on failure it is copied to 0xbff40000 (SWEETDUMP format) and the SoC is reset by the watchdog so lk2nd can read it */
+static char elog[3072];
+static unsigned elog_len;
+#define ELOG(...) do { \
+	int _n = snprintf(elog + elog_len, sizeof(elog) - elog_len, __VA_ARGS__); \
+	if (_n > 0 && elog_len + (unsigned)_n < sizeof(elog)) { elog_len += (unsigned)_n; } \
+	printf(__VA_ARGS__); \
+} while (0)
+
+static void
+elog_dump_and_reset(void)
+{
+	volatile char *d = (volatile char *)ml_io_map(0xbff40000UL, 0x40000);
+	volatile uint32_t *w = (volatile uint32_t *)ml_io_map(0x0b017000UL, 0x1000);
+	if (d) {
+		for (unsigned i = 0; i < elog_len; i++) {
+			d[16 + i] = elog[i];
+		}
+		const char *m = "SWEETDUMP";
+		for (int i = 0; i < 9; i++) {
+			d[i] = m[i];
+		}
+		*(volatile uint32_t *)(d + 12) = elog_len;
+		__builtin_arm_dsb(0xf);
+	}
+	if (w) {
+		w[2] = 0;
+		w[1] = 1;
+		w[4] = 32768;
+		w[5] = 65536;                           /* bite after ~2 s */
+		w[2] = 1;
+	}
+	for (;;) {
+	}
+}
+
 static inline uint32_t hr(unsigned o) { return *(volatile uint32_t *)(se.hc + o); }
 static inline void hw(unsigned o, uint32_t v) { *(volatile uint32_t *)(se.hc + o) = v; }
 static inline uint32_t cr(unsigned o) { return *(volatile uint32_t *)(se.core + o); }
@@ -218,37 +254,40 @@ emmc_hw_init(void)
 			udelay(1000);
 		}
 		if (e || !(ocr & 0x80000000u)) {
-			printf("SWEET EMMC: CMD1 failed e=%d ocr=0x%x\n", e, ocr);
+			ELOG("SWEET EMMC: CMD1 failed e=%d ocr=0x%x err=0x%x pres=0x%x\n", e, ocr, hr(0x30), hr(0x24));
 			return ENXIO;
 		}
 	}
 	if (send_cmd(2, 0, 0x09, &resp) || send_cmd(3, 1u << 16, 0x1a, &resp)) {
-		printf("SWEET EMMC: CMD2/CMD3 failed\n");
+		ELOG("SWEET EMMC: CMD2/CMD3 failed pres=0x%x int=0x%x\n", hr(0x24), hr(0x30));
 		return ENXIO;
 	}
 	set_clock(4);                                   /* 25 MHz */
 	if (send_cmd(7, 1u << 16, 0x1b, &resp)) {
-		printf("SWEET EMMC: CMD7 failed\n");
+		ELOG("SWEET EMMC: CMD7 failed pres=0x%x int=0x%x\n", hr(0x24), hr(0x30));
 		return ENXIO;
 	}
 	if (read_data_cmd(8, 0, ext)) {
-		printf("SWEET EMMC: EXT_CSD read failed\n");
+		ELOG("SWEET EMMC: EXT_CSD read failed pres=0x%x int=0x%x clk=0x%x host=0x%x\n", hr(0x24), hr(0x30), hr(0x2c), hr(0x28));
 		return ENXIO;
 	}
 	se.total_sectors = ext[212 / 4];
 	if (send_cmd(6, 0x03b70200, 0x1b, &resp)) {    /* bus width 8 */
+		ELOG("SWEET EMMC: CMD6 bus width failed\n");
 		return ENXIO;
 	}
 	hw(0x28, hr(0x28) | 0x20);
 	if (send_cmd(6, 0x03b90100, 0x1b, &resp)) {    /* high speed timing */
+		ELOG("SWEET EMMC: CMD6 hs failed\n");
 		return ENXIO;
 	}
 	hw(0x28, hr(0x28) | 0x04);
 	set_clock(2);                                   /* 50 MHz */
 	if (send_cmd(13, 1u << 16, 0x1a, &resp)) {
+		ELOG("SWEET EMMC: CMD13 failed\n");
 		return ENXIO;
 	}
-	printf("SWEET EMMC: card ready, %llu sectors, status 0x%x\n", se.total_sectors, resp);
+	ELOG("SWEET EMMC: card ready, %llu sectors, status 0x%x\n", se.total_sectors, resp);
 	return 0;
 }
 
@@ -270,7 +309,7 @@ emmc_find_partition(const char *want)
 {
