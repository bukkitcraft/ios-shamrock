 /* HakiosGPU.cpp: waits up to the given milliseconds for the GPU to finish drawing into the surface */
 bool MiniIOSurfaceDrawn(SweetSurface *surface, uint64_t milliseconds);
+extern "C" bool hakios_gpu_done(uint32_t fence);
+extern "C" bool hakios_gpu_ready(void);
+
+/*
+ * shamrock: the frame's (single) surface is still being drawn by the GPU. The display waits for the GPU
+ * itself (RedwoodWaitsForGPU: eagl no longer glFinish()es every frame, so backboardd prepares the next
+ * frame while the GPU draws this one); a tick whose frame is not drawn yet is skipped, nothing blocks.
+ */
+static bool
+sweet_frame_drawing(const uint8_t *rec)
+{
+	uint32_t mask, id = 0, layers = 0;
+	memcpy(&mask, rec + 0x104, 4);
+	for (uint32_t layer = 0; layer < 4; layer++) {
+		uint32_t lid;
+		memcpy(&lid, rec + 0x54 + 4 * layer, 4);
+		if ((mask & (1u << layer)) && lid != 0) {
+			layers++;
+			id = lid;
+		}
+	}
+	if (layers != 1 || !hakios_gpu_ready()) {
+		return false;
+	}
+	SweetSurface *s = sweet_surface_copy(id);
+	bool drawing = s != NULL && s->drawn != 0 && !hakios_gpu_done(s->drawn);
+	OSSafeReleaseNULL(s);
+	return drawing;
+}
 
