+/* Goodix GT9xx (Linux goodix.c): 16-bit big-endian register addresses */
+#define GT_REG_ID           0x8140u     /* product id, 4 ASCII bytes */
+#define GT_REG_CONFIG       0x8047u     /* config version, then x max (le16), y max (le16), max touches */
+#define GT_REG_COOR         0x814eu     /* status (bit 7 ready, bits 0-3 count), then 8 bytes a contact */
+#define GT_CONTACTS         5           /* 1 + 5 * 8 = 41 bytes a read, inside the QUP FIFO */
+
+static int
+gt_read(uint16_t reg, uint8_t *buf, uint32_t len)
+{
+	uint8_t a[2] = { (uint8_t)(reg >> 8), (uint8_t)reg };
+	int ret = qup_xfer(g_touch.gt_addr, false, a, 2);
+	return ret ? ret : qup_xfer(g_touch.gt_addr, true, buf, len);
+}
+
+static int
+gt_write_u8(uint16_t reg, uint8_t v)
+{
+	uint8_t a[3] = { (uint8_t)(reg >> 8), (uint8_t)reg, v };
+	return qup_xfer(g_touch.gt_addr, false, a, 3);
+}
+
+static void
+gt_config(void)
+{
+	uint8_t id[4] = { 0 }, cfg[8] = { 0 };
+	int e1 = gt_read(GT_REG_ID, id, 4);
+	int e2 = gt_read(GT_REG_CONFIG, cfg, sizeof(cfg));
+	unsigned x = (unsigned)cfg[1] | ((unsigned)cfg[2] << 8);
+	unsigned y = (unsigned)cfg[3] | ((unsigned)cfg[4] << 8);
+
+	g_touch.xres = (e2 == 0 && x) ? x : 1080;
+	g_touch.yres = (e2 == 0 && y) ? y : 1920;
+	g_touch.fingers = GT_CONTACTS;
+	printf("SHAMROCK TOUCH: Goodix at %#x: id '%c%c%c%c' (err %d), config version %#x, %u x %u, %u touches (err %d)\n",
+	    g_touch.gt_addr, id[0] ? id[0] : '?', id[1] ? id[1] : '?', id[2] ? id[2] : '?', id[3] ? id[3] : ' ', e1,
+	    cfg[0], g_touch.xres, g_touch.yres, cfg[5] & 0x0f, e2);
+	(void)gt_write_u8(GT_REG_COOR, 0);
+}
+
+static int
+gt_poll(uint32_t *events)
+{
+	uint8_t buf[1 + GT_CONTACTS * 8];
+	uint32_t pressed = 0;
+	int err = gt_read(GT_REG_COOR, buf, 1);
+
+	if (err) {
+		return err;
+	}
+	if (!(buf[0] & 0x80)) {
+		return 0;                       /* nothing new */
+	}
+	unsigned n = buf[0] & 0x0f;
+	if (n > GT_CONTACTS) {
+		n = GT_CONTACTS;
+	}
+	if (n > 0 && (err = gt_read(GT_REG_COOR, buf, 1 + n * 8))) {
+		return err;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		const uint8_t *c = &buf[1 + i * 8];
+		unsigned id = c[0] & 0x0f;
+		if (id >= HX_MAX_FINGERS) {
+			continue;
+		}
+		unsigned x = (unsigned)c[1] | ((unsigned)c[2] << 8);
+		unsigned y = (unsigned)c[3] | ((unsigned)c[4] << 8);
+		int px = (int)(x * 1080u / g_touch.xres);
+		int py = (int)(y * 1920u / g_touch.yres);
+		g_touch.last_x[id] = (uint16_t)px;
+		g_touch.last_y[id] = (uint16_t)py;
+		sweet_hid_touch((int)id, 1, px, py);
+		pressed |= 1u << id;
+		(*events)++;
+	}
+	for (unsigned i = 0; i < HX_MAX_FINGERS; i++) {
+		if ((g_touch.down_mask & (1u << i)) && !(pressed & (1u << i))) {
+			sweet_hid_touch((int)i, 0, g_touch.last_x[i], g_touch.last_y[i]);
+			(*events)++;
+		}
+	}
+	g_touch.down_mask = pressed;
+	return gt_write_u8(GT_REG_COOR, 0);
+}
