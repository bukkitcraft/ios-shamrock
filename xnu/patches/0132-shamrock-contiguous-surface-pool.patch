+
+/*
+ * shamrock: the A405's SMMU is in bypass, so the GPU can only draw into physically contiguous memory.
+ * A few minutes after boot no large contiguous run is left (vm_page_find_contiguous fails for the
+ * 13.8 MB render targets of backboardd), so a pool is taken while memory is still unfragmented
+ * (IOCoreSurfaceRoot::start, boot-arg sweetsurfpool=<MB>, default 96, 0 = none) and every surface of
+ * SWEET_POOL_MIN bytes or more gets its pixels from it (first fit, coalescing free list).
+ */
+#define SWEET_POOL_MIN          (512u << 10)
+#define SWEET_POOL_BLOCKS       128
+static IOBufferMemoryDescriptor *sweet_pool;
+static uint64_t sweet_pool_bytes;
+static IOLock *sweet_pool_lock;
+static struct { uint64_t off, size; bool used; } sweet_pool_blk[SWEET_POOL_BLOCKS];
+static uint32_t sweet_pool_nblk;
+
+static void
+sweet_pool_init(void)
+{
+	uint32_t mb = 96;
+
+	PE_parse_boot_argn("sweetsurfpool", &mb, sizeof(mb));
+	for (; mb >= 16 && sweet_pool == NULL; mb = mb * 3 / 4) {
+		sweet_pool = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+		    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMemoryPhysicallyContiguous, (vm_size_t)mb << 20, page_size);
+		if (sweet_pool != NULL) {
+			sweet_pool_bytes = (uint64_t)mb << 20;
+		}
+	}
+	if (sweet_pool == NULL) {
+		IOLog("SWEET SURF: no contiguous surface pool (GPU cannot draw into large surfaces)\n");
+		return;
+	}
+	sweet_pool_lock = IOLockAlloc();
+	sweet_pool_blk[0].off = 0;
+	sweet_pool_blk[0].size = sweet_pool_bytes;
+	sweet_pool_blk[0].used = false;
+	sweet_pool_nblk = 1;
+	IOLog("SWEET SURF: contiguous surface pool %llu MB at phys 0x%llx\n", sweet_pool_bytes >> 20,
+	    (uint64_t)sweet_pool->getPhysicalSegment(0, NULL, kIOMemoryMapperNone));
+}
+
+static bool
+sweet_pool_alloc(uint64_t want, uint64_t *off, uint64_t *size)
+{
+	bool ok = false;
+
+	want = round_page_64(want);
+	IOLockLock(sweet_pool_lock);
+	for (uint32_t i = 0; i < sweet_pool_nblk; i++) {
+		if (sweet_pool_blk[i].used || sweet_pool_blk[i].size < want) {
+			continue;
+		}
+		if (sweet_pool_blk[i].size > want) {
+			if (sweet_pool_nblk >= SWEET_POOL_BLOCKS) {
+				break;
+			}
+			memmove(&sweet_pool_blk[i + 2], &sweet_pool_blk[i + 1], (sweet_pool_nblk - i - 1) * sizeof(sweet_pool_blk[0]));
+			sweet_pool_blk[i + 1].off = sweet_pool_blk[i].off + want;
+			sweet_pool_blk[i + 1].size = sweet_pool_blk[i].size - want;
+			sweet_pool_blk[i + 1].used = false;
+			sweet_pool_blk[i].size = want;
+			sweet_pool_nblk++;
+		}
+		sweet_pool_blk[i].used = true;
+		*off = sweet_pool_blk[i].off;
+		*size = want;
+		ok = true;
+		break;
+	}
+	IOLockUnlock(sweet_pool_lock);
+	return ok;
+}
+
+static void
+sweet_pool_free(uint64_t off)
+{
+	IOLockLock(sweet_pool_lock);
+	for (uint32_t i = 0; i < sweet_pool_nblk; i++) {
+		if (sweet_pool_blk[i].off != off || !sweet_pool_blk[i].used) {
+			continue;
+		}
+		sweet_pool_blk[i].used = false;
+		if (i + 1 < sweet_pool_nblk && !sweet_pool_blk[i + 1].used) {
+			sweet_pool_blk[i].size += sweet_pool_blk[i + 1].size;
+			memmove(&sweet_pool_blk[i + 1], &sweet_pool_blk[i + 2], (sweet_pool_nblk - i - 2) * sizeof(sweet_pool_blk[0]));
+			sweet_pool_nblk--;
+		}
+		if (i > 0 && !sweet_pool_blk[i - 1].used) {
+			sweet_pool_blk[i - 1].size += sweet_pool_blk[i].size;
+			memmove(&sweet_pool_blk[i], &sweet_pool_blk[i + 1], (sweet_pool_nblk - i - 1) * sizeof(sweet_pool_blk[0]));
+			sweet_pool_nblk--;
+		}
+		break;
+	}
+	IOLockUnlock(sweet_pool_lock);
+}
