diff --git c/bsd/dev/shamrock_rpm.c i/bsd/dev/shamrock_rpm.c
index a32fe67..133e2da 100644
--- c/bsd/dev/shamrock_rpm.c
+++ i/bsd/dev/shamrock_rpm.c
@@ -26,6 +26,8 @@ extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 #define SMEM_PA                 0x86300000ULL
 #define SMEM_SIZE               0x100000
 #define RPM_IPC_PA              0x0b011008ULL           /* APCS IPC; bit 0: RPM */
+#define SMEM_AUX_PA             0x00060000ULL           /* "aux-mem1": RPM message RAM (the RPM channel's info and FIFOs) */
+#define SMEM_AUX_SIZE           0x8000
 #define SMEM_TOC                0xd0                    /* smem_header.toc[] (after free_offset and a reserved word) */
 #define SMEM_ITEMS              512
 
@@ -45,7 +47,7 @@ struct smd_info_w {
 	uint32_t tail, head;
 };
 
-static volatile uint8_t *smem;
+static volatile uint8_t *smem, *smem_aux;
 static volatile uint32_t *ipc;
 static volatile void *tx_info, *rx_info;
 static bool word_info;
@@ -61,13 +63,20 @@ smem_item(uint32_t item, uint32_t *size)
 		return NULL;
 	}
 	volatile uint32_t *e = (volatile uint32_t *)(smem + SMEM_TOC + 16 * item);
-	if (e[0] != 1 || (e[3] & ~3u) != 0 || e[1] + e[2] > SMEM_SIZE) {      /* allocated, in the main region */
+	uint32_t aux = e[3] & ~3u;
+	if (e[0] != 1) {
 		return NULL;
 	}
 	if (size) {
 		*size = e[2];
 	}
-	return smem + e[1];
+	if (aux == 0 && e[1] + e[2] <= SMEM_SIZE) {
+		return smem + e[1];
+	}
+	if (aux == SMEM_AUX_PA && smem_aux != NULL && e[1] + e[2] <= SMEM_AUX_SIZE) {
+		return smem_aux + e[1];         /* (lk2nd: rpm_requests info at +0, FIFOs at +0x800) */
+	}
+	return NULL;
 }
 
 #define INFO_GET(p, f)      (word_info ? ((volatile struct smd_info_w *)(p))->f : ((volatile struct smd_info_b *)(p))->f)
@@ -261,6 +270,7 @@ shamrock_rpm_init(void)
 	}
 	smem = (volatile uint8_t *)ml_io_map(SMEM_PA, SMEM_SIZE);
 	ipc = (volatile uint32_t *)ml_io_map(RPM_IPC_PA & ~0xfffULL, 0x1000);
+	smem_aux = (volatile uint8_t *)ml_io_map(SMEM_AUX_PA, SMEM_AUX_SIZE);
 	if (smem == NULL || ipc == NULL) {
 		printf("SHAMROCK RPM: cannot map SMEM / IPC\n");
 		return;
