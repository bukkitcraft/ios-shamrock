@@ -2578,7 +2579,12 @@ static bool need_ram_ranges_init = true;
 bool
 pmap_is_bad_ram(__unused ppnum_t ppn)
 {
+#if defined(SWEET)
+	/* shamrock: firmware hole inside the RAM range; pmap_startup keeps it off the free lists */
