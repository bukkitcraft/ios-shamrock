+				chunk = shamrock_phys_holes[h].end;
+			}
+		}
+	}
+#else
 	arm_vm_physmap_slide(temp_ptov_table, (args->topOfKernelData - gPhysBase + gVirtBase),
 	    real_avail_end - args->topOfKernelData, AP_RWNA, ARM64_GRANULE_ALLOW_BLOCK | ARM64_GRANULE_ALLOW_HINT); // rest of physmem
+#endif
 
 	assert((temp_ptov_table[ptov_index - 1].va + temp_ptov_table[ptov_index - 1].len) <= physmap_end);
 
diff --git c/osfmk/arm64/shamrock_phys.h i/osfmk/arm64/shamrock_phys.h
new file mode 100644
index 0000000..1d35393
--- /dev/null
+++ i/osfmk/arm64/shamrock_phys.h
@@ -0,0 +1,42 @@
+/*
+ * SHAMROCK (MSM8952, 3 GB) physical memory holes inside xnu's RAM range.
+ *
+ * lk2nd's FDT memory node is <0x20000000 0x60000000>, <0x80000000 0x60000000>: one run of DRAM
+ * from 0x20000000 to 0xe0000000. Firmware owns the start of the upper bank: TZ/QSEE, SMEM,
+ * modem (mpss 0x86c00000), LPASS (to 0x8da00000), lk2nd and its boot buffers, the boot splash
+ * at 0x83200000 and our own scanout buffer at 0x90000000-0x91000000. With an ADT dram range
+ * that starts at 0x20000000 (shamrock-d21-*-full.adt), that span is a hole: pa_valid() is false
+ * (the pmap treats it as I/O, so ml_io_map of the scanout buffer still works), pmap_is_bad_ram()
+ * keeps its vm_pages off the free lists, and the physmap leaves it unmapped so the CPU never
+ * speculates into TrustZone-protected memory. As ios-river's 0205 for the Moto G7.
+ *
+ * With the old ADT (RAM from 0x91000000) the hole lies below RAM and changes nothing.
+ */
+#ifndef _ARM64_SHAMROCK_PHYS_H_
+#define _ARM64_SHAMROCK_PHYS_H_
+
+#if defined(SWEET)
+#include <stdint.h>
+#include <stdbool.h>
+
+#define SHAMROCK_PHYS_HOLES 1
+
+static const struct {
+	uint64_t start, end;
+} shamrock_phys_holes[SHAMROCK_PHYS_HOLES] = {
+	{ 0x80000000ULL, 0x91000000ULL },
+};
+
+static inline bool
+shamrock_phys_hole(uint64_t pa)
+{
+	for (int i = 0; i < SHAMROCK_PHYS_HOLES; i++) {
+		if (pa >= shamrock_phys_holes[i].start && pa < shamrock_phys_holes[i].end) {
+			return true;
+		}
+	}
+	return false;
+}
+#endif /* SWEET */
+
+#endif /* _ARM64_SHAMROCK_PHYS_H_ */
