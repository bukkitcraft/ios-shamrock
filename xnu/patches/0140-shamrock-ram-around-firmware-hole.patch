+#include <arm64/shamrock_phys.h>
 #include <mach_assert.h>
 #include <vm/vm_page.h>
 
@@ -74,6 +75,12 @@ extern pmap_paddr_t vm_first_phys, vm_last_phys;
 static inline bool
 pa_valid(pmap_paddr_t pa)
 {
+#if defined(SWEET)
+	/* shamrock: the firmware hole inside the RAM range behaves as I/O */
+	if (shamrock_phys_hole(pa)) {
+		return false;
+	}
+#endif
 	return (pa >= vm_first_phys) && (pa < vm_last_phys);
 }
 
