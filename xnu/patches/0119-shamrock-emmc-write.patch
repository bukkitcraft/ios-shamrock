+/* Single-block PIO write (CMD24), then wait for the card to leave the programming state. */
+static int
+write_data_cmd(uint32_t lba, const uint32_t *buf)
+{
+	uint64_t t0 = mach_absolute_time();
+	hw(0x2c, hr(0x2c) | (0x06u << 24));
+	while (((hr(0x2c) >> 24) & 6) && !timed_out(t0, 100000)) {
+	}
+	t0 = mach_absolute_time();
+	while (hr(0x24) & 3) {
+		if (timed_out(t0, 100000)) {
+			return -1;
+		}
+	}
+	hw(0x34, 0x0000ffff);
+	hw(0x30, 0xffffffff);
+	hw(0x04, (1u << 16) | 512 | (7 << 12));
+	hw(0x08, lba);
+	hw(0x0c, (((24u << 8) | 0x3a) << 16) | 0x0000);     /* write direction, no DMA */
+	t0 = mach_absolute_time();
+	for (;;) {
+		if (hr(0x30) & 0x8000) {
+			cmd_reset();
+			return -2;
+		}
+		if (hr(0x24) & 0x400) {                 /* buffer write enable */
+			break;
+		}
+		if (timed_out(t0, 500000)) {
+			cmd_reset();
+			return -3;
+		}
+	}
+	for (int i = 0; i < 128; i++) {
+		hw(0x20, buf[i]);
+	}
+	t0 = mach_absolute_time();
+	while (!(hr(0x30) & 2)) {
+		if (hr(0x30) & 0x8000) {
+			cmd_reset();
+			return -4;
+		}
+		if (timed_out(t0, 1000000)) {
+			cmd_reset();
+			return -5;
+		}
+	}
+	hw(0x30, 0xffffffff);
+	/* CMD13 until READY_FOR_DATA (bit 8) and state == tran (4) */
+	t0 = mach_absolute_time();
+	for (;;) {
+		uint32_t r = 0;
+		if (send_cmd(13, 1u << 16, 0x1a, &r) == 0 && (r & 0x100) && (((r >> 9) & 0xf) == 4)) {
+			break;
+		}
+		if (timed_out(t0, 2000000)) {
+			return -6;
+		}
+	}
+	return 0;
+}
+
+static int
+emmc_write_sectors(uint64_t lba, const void *src)
+{
+	return write_data_cmd((uint32_t)lba, (const uint32_t *)src) ? EIO : 0;
+}
