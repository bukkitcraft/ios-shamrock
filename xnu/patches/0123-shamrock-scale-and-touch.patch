-			irq = touch_irq();
-			if (irq & SE_ERRORS) {
-				continue;
-			}
-			touch_wr(st.se, SE_IRQ_CLR, irq);
-			if (st.got == nr && st.sent == nt) {
-				return 0;
-			}
-			err = EIO;
-			break;
-		}
-		/* Preserve DONE/errors if they arrive during this iteration. */
-		touch_wr(st.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
