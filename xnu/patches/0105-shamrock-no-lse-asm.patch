diff --git c/osfmk/arm/commpage/commpage_asm.s w/osfmk/arm/commpage/commpage_asm.s
index da0bbba..505db32 100644
--- c/osfmk/arm/commpage/commpage_asm.s
+++ w/osfmk/arm/commpage/commpage_asm.s
@@ -273,7 +273,13 @@ _pfz_trylock_and_enqueue:
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
-	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+	// shamrock: Cortex-A53 has no LSE; LL/SC equivalent of casa w10, w11, [x3]
+1:	ldaxr	w12, [x3]
+	cmp	w12, w10
+	b.ne	2f
+	stxr	w13, w11, [x3]
+	cbnz	w13, 1b
+2:	mov	w10, w12
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
@@ -323,7 +329,13 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
-	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+	// shamrock: Cortex-A53 has no LSE; LL/SC equivalent of casa w10, w11, [x2]
+1:	ldaxr	w12, [x2]
+	cmp	w12, w10
+	b.ne	2f
+	stxr	w13, w11, [x2]
+	cbnz	w13, 1b
+2:	mov	w10, w12
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
