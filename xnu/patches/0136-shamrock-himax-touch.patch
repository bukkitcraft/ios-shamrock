+			while (got < nrx && (touch_rd(g_touch.qup, QUP_OPERATIONAL) & QUP_IN_NOT_EMPTY)) {
+				word = touch_rd(g_touch.qup, QUP_IN_FIFO_BASE);
+				for (uint32_t j = 0; j < 4 && got < nrx; j++, got++) {
+					if (got >= 2) {
+						buf[got - 2] = (uint8_t)(word >> (8 * j));
+					}
+				}
+			}
+			if (got >= nrx && !(i2c & I2C_STATUS_BUS_ACTIVE)) {
+				ret = 0;
+				break;
+			}
+		} else if ((op & QUP_MX_OUTPUT_DONE) && !(op & QUP_OUT_NOT_EMPTY) && !(i2c & I2C_STATUS_BUS_ACTIVE)) {
+			ret = 0;
+			break;
+		}
+		delay(1);
+	}
+	touch_wr(g_touch.qup, QUP_OPERATIONAL, 0x000ff0u);    /* clear the service flags */
+	(void)qup_set_state(QUP_RESET_STATE);
+	return ret;
+}
