+	ret = ETIMEDOUT;
+	for (int spin = 0; spin < 20000; spin++) {      /* ~20 ms: 66 bytes at 400 kHz take 1.5 ms */
+		uint32_t i2c = touch_rd(g_touch.qup, QUP_I2C_STATUS);
+		uint32_t err = touch_rd(g_touch.qup, QUP_ERROR_FLAGS) & QUP_STATUS_ERROR_FLAGS;
+		uint32_t op = touch_rd(g_touch.qup, QUP_OPERATIONAL);
