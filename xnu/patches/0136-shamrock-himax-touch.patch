+/*
+ * One I2C message: a write of `len` bytes, or a read of `len` bytes, with START and STOP.
+ * 0, ENXIO (NACK), EIO (bus/QUP error), EINVAL or ETIMEDOUT.
+ */
+static int
+qup_xfer(uint8_t addr, bool rd, uint8_t *buf, uint32_t len)
+{
+	uint8_t tx[4 + 64];
