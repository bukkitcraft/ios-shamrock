+	tx[ntx++] = rd ? QUP_TAG_V2_DATARD_STOP : QUP_TAG_V2_DATAWR_STOP;
+	tx[ntx++] = (uint8_t)len;
+	if (!rd) {
+		for (uint32_t i = 0; i < len; i++) {
+			tx[ntx++] = buf[i];
+		}
+	}
+
+	touch_wr(g_touch.qup, QUP_SW_RESET, 1);
+	if (qup_poll_state(QUP_RESET_STATE, QUP_STATE_MASK)) {
+		return EIO;
+	}
+	touch_wr(g_touch.qup, QUP_I2C_MASTER_GEN, QUP_V2_TAGS_EN);
+	touch_wr(g_touch.qup, QUP_IO_MODE, QUP_REPACK_EN);
+	touch_wr(g_touch.qup, QUP_MX_OUTPUT_CNT, 0);
+	touch_wr(g_touch.qup, QUP_MX_INPUT_CNT, 0);
+	touch_wr(g_touch.qup, QUP_MX_WRITE_CNT, ntx);
+	touch_wr(g_touch.qup, QUP_MX_READ_CNT, nrx);
+	touch_wr(g_touch.qup, QUP_CONFIG, I2C_MINI_CORE | I2C_N_VAL_V2 | (rd ? 0 : QUP_NO_INPUT));
+
+	if ((ret = qup_set_state(QUP_RUN_STATE))) {
+		return ret;
+	}
+	touch_wr(g_touch.qup, QUP_I2C_CLK_CTL, QUP_CLK_CTL_400K);
+	if ((ret = qup_set_state(QUP_PAUSE_STATE))) {
+		return ret;
+	}
+	for (uint32_t i = 0; i < ntx; i += 4) {
+		uint32_t w = 0;
+		for (uint32_t j = 0; j < 4 && i + j < ntx; j++) {
+			w |= (uint32_t)tx[i + j] << (8 * j);
+		}
+		touch_wr(g_touch.qup, QUP_OUT_FIFO_BASE, w);
