+/*
+ * shamrock: double buffering. r53 (GPU, sysmem): the frame visibly painted itself from top to
+ * bottom: present() scales each frame into the very memory the MDP is scanning. A second panel
+ * buffer at 0x90800000 (inside the firmware hole, never xnu's RAM; 0x90000000 + 2 x 8.3 MB fits
+ * below 0x91000000): each frame is drawn into the one not shown, then the MDP's RGB0 pipe is
+ * pointed at it (SRC0_ADDR) and flushed (CTL0 FLUSH bit 3), which takes effect at the next
+ * vsync; the next frame waits for that flush bit to clear before drawing into the other one.
+ * Same registers as the s1 shim's display switch. sweetfb_double=0: one buffer, as before.
+ */
+#define SWEET_FB_BUF1_PHYS      0x90800000ULL
+#define SWEET_MDP_PA            0x01a00000ULL   /* MDP base 0x01a01000: CTL0 at +0x2000, RGB0 at +0x15000 */
+#define SWEET_MDP_CTL0_FLUSH    (0x2000 + 0x18)
+#define SWEET_MDP_RGB0_SRC0     (0x15000 + 0x14)
 /* HakiosGPU.cpp: waits up to the given milliseconds for the GPU to finish drawing into the surface */
 bool MiniIOSurfaceDrawn(SweetSurface *surface, uint64_t milliseconds);
 
