diff --git c/osfmk/arm64/sweet_stall.c i/osfmk/arm64/sweet_stall.c
index 8cd77fa..9af87d1 100644
--- c/osfmk/arm64/sweet_stall.c
+++ i/osfmk/arm64/sweet_stall.c
@@ -231,6 +231,31 @@ sweet_live_fire(thread_call_param_t p0, thread_call_param_t p1)
 	thread_call_enter_delayed(s_live_call, deadline);
 }
 
+/* shamrock: write the live log now (callers that may not survive the next step, e.g. the RPM client) */
+void sweet_live_snapshot(void);
+void
+sweet_live_snapshot(void)
+{
+	if (s_fired) {
+		return;
+	}
+	if (!s_live_va) {
+		s_live_va = ml_io_map(STALL_PA, STALL_SIZE);
+		if (!s_live_va) {
+			return;
+		}
+	}
+	s_region_take();
+	sbuf = (char *)s_live_va;
+	spos = 0;
+	s_s("LIVE (snapshot) now=");
+	s_x(mach_absolute_time());
+	s_c('\n');
+	s_msgbuf_tail(96 * 1024);
+	s_finish();
+	s_region_give();
+}
+
 static void
 sweet_stall_fire(thread_call_param_t p0, thread_call_param_t p1)
 {
