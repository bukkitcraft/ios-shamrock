+/*
+ * shamrock: the vsync notifications came from a free-running 16.667 ms timer, not from the panel: the
+ * two drift apart, so a frame stayed on screen for one or two refreshes at random (judder) and
+ * CoreAnimation paced its animations on an uneven clock. Each tick now reads INTF1's line counter and
+ * aims the next tick at the start of the panel's next frame (sweetfb_vsynclock=0: free-running).
+ * The 5 s status reports how many panel frames passed between ticks (ideal: always 1).
+ */
+static uint32_t
+sweet_next_vsync_us(AppleCLCD *fb)
+{
+	if (fb->fINTF == NULL) {
+		return SWEET_FB_VSYNC_US;
+	}
+	uint32_t frame = fb->fINTF[SWEET_INTF1_FRAME_COUNT], line = fb->fINTF[SWEET_INTF1_LINE_COUNT] & 0xffff;
+	uint32_t delta = frame - fb->fLastPanelFrame;
+	fb->fLastPanelFrame = frame;
+	fb->fFrameDelta[delta < 3 ? delta : 3]++;
+	if (line > fb->fPanelLines) {
+		fb->fPanelLines = line;         /* (the largest line seen: lines per frame incl. porches) */
+	}
+	fb->fLineSum += line;
+	fb->fLineN++;
+	if (!fb->fVsyncLock || fb->fPanelLines < 1000) {
+		return SWEET_FB_VSYNC_US;
+	}
+	/* time left until the panel's next frame starts, plus a few lines into it */
+	uint32_t total = fb->fPanelLines + 1, target = 8;
+	int32_t lines_left = (int32_t)(total - line) + (int32_t)target;
+	uint32_t us = (uint32_t)((uint64_t)lines_left * SWEET_FB_VSYNC_US / total);
+	if (us < SWEET_FB_VSYNC_US / 2) {
+		us += SWEET_FB_VSYNC_US;        /* just past the start already: the frame after */
+	}
+	return us;
+}
