 #define SWEET_MDP_CTL0_FLUSH    0x18
 #define SWEET_MDP_RGB0_SRC0     0x14
+
+/*
+ * shamrock: MDP scanout of the iOS surface itself through the VIG0 pipe (the only MSM8952 pipe that
+ * scales: Linux mdp5_cfg msm8x52, RGB pipes only decimate), bilinear 1242x2208 -> 1080x1920, no copy
+ * by this processor (r56: GL ~13 ms a frame, the rest of every frame was present()'s CPU scaling).
+ * State found on the phone (lk2nd): RGB0 is the base stage of CTL0 (LAYER0 0x200), SMP MMBs 0-1 belong
+ * to RGB0 (client 7), MMBs 2-7 are free; VIG0 (client 1) gets MMBs 2-5. A frame that is one full-screen
+ * contiguous BGRA surface goes to VIG0; any other frame is drawn by the processor into the panel buffers
+ * and RGB0 is the base stage again. sweetfb_mdp=0: never VIG0.
+ */
+#define SWEET_MDP_TOP_PA        0x01a01000ULL   /* SMP_ALLOC_W 0x80, SMP_ALLOC_R 0x130 */
+#define SWEET_MDP_VIG0_PA       0x01a05000ULL   /* MDP base + 0x4000 */
+#define SWEET_MDP_LAYER0        0x00            /* CTL0 */
+#define SWEET_FLUSH_VIG0        (1u << 0)
+#define SWEET_FLUSH_RGB0        (1u << 3)
+#define SWEET_FLUSH_LM0         (1u << 6)
+#define SWEET_FLUSH_CTL         (1u << 17)
+#define SWEET_FLUSH_ALL         (SWEET_FLUSH_VIG0 | SWEET_FLUSH_RGB0 | SWEET_FLUSH_LM0 | SWEET_FLUSH_CTL)
 /* HakiosGPU.cpp: waits up to the given milliseconds for the GPU to finish drawing into the surface */
