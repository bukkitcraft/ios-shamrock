+/*
+ * One frame by VIG0 if it is a single full-screen BGRA surface in physically contiguous memory:
+ * true if done (the surface is held until VIG0 has stopped reading it), false: draw it by hand.
+ */
+bool
+AppleCLCD::presentMDP(const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104), id = 0, layers = 0;
+
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+		if ((mask & (1u << layer)) && get32(rec, 0x54 + 4 * layer) != 0) {
+			layers++;
+			id = get32(rec, 0x54 + 4 * layer);
+		}
+	}
+	if (layers != 1) {
+		return false;
+	}
+	SweetSurface *s = sweet_surface_copy(id);
+	if (s == NULL || s == fSurface || s->memory == NULL || s->pixelFormat != SWEET_FB_FORMAT_BGRA ||
+	    s->bytesPerElement != 4 || s->width != fLogicalW || s->height != fLogicalH || (s->bytesPerRow & 15) != 0) {
+		OSSafeReleaseNULL(s);
+		return false;
+	}
+	IOByteCount len = 0;
+	addr64_t phys = s->memory->getPhysicalSegment(s->offset, &len, kIOMemoryMapperNone);
+	if (phys == 0 || phys + (uint64_t)s->bytesPerRow * s->height > 0x100000000ULL ||
+	    len < (IOByteCount)s->bytesPerRow * s->height) {
+		OSSafeReleaseNULL(s);
+		return false;
+	}
+	if (s->drawn != 0) {
+		(void)MiniIOSurfaceDrawn(s, 50);       /* the GPU is done with it */
+	}
+	__builtin_arm_dsb(0xf);
+	if (!fVigSetUp) {
+		/* SMP: MMB 2 (ALLOC reg 0, client field 2) and MMBs 3-5 (reg 1) to VIG0 (client 1) */
+		uint32_t w0 = (fTop[0x80 / 4] & 0x0000ffffu) | (1u << 16);
+		fTop[0x80 / 4] = w0;
+		fTop[0x130 / 4] = w0;
+		fTop[0x84 / 4] = 0x00010101u;
+		fTop[0x134 / 4] = 0x00010101u;
+		uint32_t sw = s->width, sh = s->height, dw = fWidth, dh = fHeight;
+		uint32_t stepx = (uint32_t)(((uint64_t)1 << 21) * sw / dw), stepy = (uint32_t)(((uint64_t)1 << 21) * sh / dh);
+		fVIG0[0x00 / 4] = (sh << 16) | sw;      /* SRC_SIZE */
+		fVIG0[0x04 / 4] = (sh << 16) | sw;      /* SRC_IMG_SIZE */
+		fVIG0[0x08 / 4] = 0;                    /* SRC_XY */
+		fVIG0[0x0c / 4] = (dh << 16) | dw;      /* OUT_SIZE */
+		fVIG0[0x10 / 4] = 0;                    /* OUT_XY */
+		fVIG0[0x30 / 4] = 0x000236ff;           /* SRC_FORMAT: XRGB8888 as the panel buffers (s1 shim) */
+		fVIG0[0x34 / 4] = 0x03020001;           /* UNPACK_PATTERN: B, G, R, X */
+		fVIG0[0x38 / 4] = 0;                    /* SRC_OP_MODE */
+		fVIG0[0x48 / 4] = 0x87;                 /* FETCH_CONFIG, as RGB0 */
+		fVIG0[0x50 / 4] = 0x100;                /* REQPRIO_FIFO_WM 0-2: 4 MMBs, RGB0's scale (2 MMBs: 0x80/0x100/0x180) */
+		fVIG0[0x54 / 4] = 0x200;
+		fVIG0[0x58 / 4] = 0x300;
+		fVIG0[0xb4 / 4] = 0;                    /* DECIMATION */
+		fVIG0[0x200 / 4] = 0;                   /* VIG OP_MODE: no CSC (RGB in, RGB out) */
+		fVIG0[0x210 / 4] = stepx;               /* SCALE_PHASE_STEP_X/Y, CR (the same for RGB) */
+		fVIG0[0x214 / 4] = stepy;
+		fVIG0[0x218 / 4] = stepx;
+		fVIG0[0x21c / 4] = stepy;
+		fVIG0[0x220 / 4] = 0;                   /* SCALE_INIT_PHASE_X/Y */
+		fVIG0[0x224 / 4] = 0;
+		fVIG0[0x204 / 4] = 0x3 | (1u << 8) | (1u << 10) | (1u << 12) | (1u << 14) | (1u << 16) | (1u << 18);   /* scale X, Y; bilinear */
+		fVigSetUp = true;
+		IOLog("SWEET FB: VIG0 scanout: %ux%u -> %ux%u bilinear, phase steps %#x %#x, SMP %#x/%#x\n", sw, sh, dw, dh,
+		    stepx, stepy, fTop[0x80 / 4], fTop[0x84 / 4]);
+	}
+	fVIG0[0x24 / 4] = s->bytesPerRow;               /* SRC_YSTRIDE0 */
+	fVIG0[0x14 / 4] = (uint32_t)phys;               /* SRC0_ADDR */
+	__builtin_arm_dsb(0xf);
+	if (!fVigOn) {
+		fMDP[SWEET_MDP_LAYER0 / 4] = 0x1;           /* VIG0 the base stage, RGB0 off the mixer */
+		fVigOn = true;
+		fMDP[SWEET_MDP_CTL0_FLUSH / 4] = fMDP[SWEET_MDP_CTL0_FLUSH / 4] | SWEET_FLUSH_VIG0 | SWEET_FLUSH_RGB0 |
+		    SWEET_FLUSH_LM0 | SWEET_FLUSH_CTL;
+	} else {
+		fMDP[SWEET_MDP_CTL0_FLUSH / 4] = fMDP[SWEET_MDP_CTL0_FLUSH / 4] | SWEET_FLUSH_VIG0;
+	}
+	__builtin_arm_dsb(0xf);
+	OSSafeReleaseNULL(fScanned[1]);
+	fScanned[1] = s;                                /* (held: VIG0 reads it from the next vsync on) */
+	if ((++fVigFrames % 600) == 1) {
+		IOLog("SWEET FB: %u frames by VIG0, %u by the processor\n", fVigFrames, fCpuFrames);
+	}
+	return true;
+}
