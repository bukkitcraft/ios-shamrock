+#define SHAMROCK_GCC_PA   0x01800000ULL
+#define SHAMROCK_GPU_PA   0x01c00000ULL
+
+#define APCS_GPLL_ENA_VOTE 0x45000
+#define GPLL0_STATUS       0x2101c
+#define GFX3D_CLK_SRC_CMD  0x59000
+#define GFX3D_CLK_SRC_CFG  0x59004
+#define OXILI_GX_GDSCR     0x5901c
+#define GCC_OXILI_GFX3D    0x59020
+#define GCC_OXILI_GMEM     0x59024
+#define GCC_OXILI_AHB      0x59028
+#define GCC_BIMC_GPU       0x59030
+#define GCC_BIMC_GFX       0x59034
+#define GCC_OXILI_TIMER    0x59040
+#define APCS_SMMU_VOTE     0x4500c
+
+#define RING_WORDS        8192
+#define RING_SIZE         (RING_WORDS * 4)
+
+#define pm4_pkt0(reg, cnt) (CP_TYPE0_PKT | (((cnt) - 1) << 16) | ((reg) & 0x7fff))
+#define pm4_pkt2()         (CP_TYPE2_PKT)
+#define pm4_pkt3(op, cnt)  (CP_TYPE3_PKT | (((cnt) - 1) << 16) | (((op) & 0xff) << 8))
+
+static volatile uint32_t *g_gcc;
+static volatile uint32_t *g_gpu;
+static volatile uint32_t *g_ring;
+static uint64_t g_ring_phys;
+static uint32_t g_ring_wptr = 0;
+static uint32_t g_fence = 0;
+static bool g_ready = false;
+
+static inline void gpu_write(uint32_t reg, uint32_t val)
+{
+	g_gpu[reg] = val;
+}
+
+static inline uint32_t gpu_read(uint32_t reg)
+{
+	return g_gpu[reg];
+}
+
+static inline void gcc_write(uint32_t reg, uint32_t val)
+{
+	g_gcc[reg >> 2] = val;
+}
+
+static inline uint32_t gcc_read(uint32_t reg)
+{
+	return g_gcc[reg >> 2];
+}
+
+static void ring_out(uint32_t val)
+{
+	g_ring[g_ring_wptr] = val;
+	g_ring_wptr = (g_ring_wptr + 1) % RING_WORDS;
+}
+
+static void ring_flush(void)
+{
+	flush_dcache64((uint64_t)g_ring, RING_SIZE, 0);
+	gpu_write(REG_A4XX_CP_RB_WPTR, g_ring_wptr);
+}
+
+static bool a4xx_idle(void)
+{
+	for (int i = 0; i < 50000; i++) {
+		uint32_t rptr = gpu_read(REG_A4XX_CP_RB_RPTR);
+		if (rptr == g_ring_wptr) {
+			return true;
+		}
+		delay(20);
+	}
+	return false;
+}
+
+static bool power_on_oxili(void)
+{
+	IOLog("SWEET A405: starting power & clock sequencing...\n");
+
+	/*
+	 * 1. Vote for GPLL0 (800 MHz general PLL) in APCS_GPLL_ENA_VOTE.
+	 */
+	gcc_write(APCS_GPLL_ENA_VOTE, gcc_read(APCS_GPLL_ENA_VOTE) | 1u);
+	for (int i = 0; i < 2000; i++) {
+		if (gcc_read(GPLL0_STATUS) & (1u << 17)) {
+			break;
+		}
+		delay(10);
+	}
+
+	/*
+	 * 2. Vote for GPU SMMU TCU/TBU & GTCU AHB clocks in APCS_SMMU_VOTE (0x4500c)
+	 *    to prevent memory transaction stalls on the system bus.
+	 */
+	gcc_write(APCS_SMMU_VOTE, gcc_read(APCS_SMMU_VOTE) | (1u << 13) | (1u << 3) | (1u << 2));
+
+	/*
+	 * 3. Configure GFX3D root clock (GFX3D_CLK_SRC):
+	 *    Source: GPLL0 (src=1 -> bits 10:8 = 1)
+	 *    Divider: 2 (400 MHz safe operating frequency, 2*div - 1 = 3 -> bits 4:0 = 3)
+	 *    CFG = (1 << 8) | 3 = 0x00000103.
+	 */
+	gcc_write(GFX3D_CLK_SRC_CFG, (1u << 8) | 3u);
+	gcc_write(GFX3D_CLK_SRC_CMD, 1u);
+	for (int i = 0; i < 2000; i++) {
+		if (!(gcc_read(GFX3D_CLK_SRC_CMD) & 1u)) {
+			break;
+		}
+		delay(10);
+	}
+	delay(50);
+
+	/*
+	 * 4. Configure OXILI_GX_GDSCR wait states and clear SW_OVERRIDE / HW_CONTROL:
+	 *    EN_REST_WAIT_VAL (0x2 << 20) | EN_FEW_WAIT_VAL (0x8 << 16) | CLK_DIS_WAIT_VAL (0x2 << 12)
+	 */
+	uint32_t val = gcc_read(OXILI_GX_GDSCR);
+	val &= ~((0xFu << 20) | (0xFu << 16) | (0xFu << 12) | (1u << 1) | (1u << 2));
+	val |= (0x2u << 20) | (0x8u << 16) | (0x2u << 12);
+	gcc_write(OXILI_GX_GDSCR, val);
+
+	/*
+	 * 5. Power ON GDSC power domain by de-asserting SW_COLLAPSE (bit 0):
+	 */
+	val &= ~1u;
+	gcc_write(OXILI_GX_GDSCR, val);
+
+	bool ok = false;
+	for (int i = 0; i < 5000; i++) {
+		if (gcc_read(OXILI_GX_GDSCR) & (1u << 31)) {
+			ok = true;
+			break;
+		}
+		delay(10);
+	}
+	if (!ok) {
+		IOLog("SWEET A405: OXILI_GX_GDSC power on timeout (GDSCR=0x%08x)\n", gcc_read(OXILI_GX_GDSCR));
+		return false;
+	}
+	delay(50);
+
+	/*
+	 * 6. Enable all 6 clock branches inside the power domain and bus interfaces:
+	 *    OXILI_AHB   (0x59028)
+	 *    OXILI_GFX3D (0x59020)
+	 *    OXILI_GMEM  (0x59024)
+	 *    BIMC_GPU    (0x59030)
+	 *    BIMC_GFX    (0x59034)
+	 *    OXILI_TIMER (0x59040)
+	 */
+	gcc_write(GCC_OXILI_AHB, gcc_read(GCC_OXILI_AHB) | 1u);
+	gcc_write(GCC_OXILI_GFX3D, gcc_read(GCC_OXILI_GFX3D) | 1u);
+	gcc_write(GCC_OXILI_GMEM, gcc_read(GCC_OXILI_GMEM) | 1u);
+	gcc_write(GCC_BIMC_GPU, gcc_read(GCC_BIMC_GPU) | 1u);
+	gcc_write(GCC_BIMC_GFX, gcc_read(GCC_BIMC_GFX) | 1u);
+	gcc_write(GCC_OXILI_TIMER, gcc_read(GCC_OXILI_TIMER) | 1u);
+
+	/* Wait for branches to assert (halt bits 31:28 become 0) */
+	for (int i = 0; i < 2000; i++) {
+		if (!((gcc_read(GCC_OXILI_AHB) | gcc_read(GCC_OXILI_GFX3D) | gcc_read(GCC_BIMC_GPU)) & (0xFu << 28))) {
+			break;
+		}
+		delay(10);
+	}
+	delay(50);
+
+	IOLog("SWEET A405: GDSC powered on, all 9 GPU clocks active at 400 MHz\n");
+	return true;
+}
+
+static bool a4xx_hw_init(void)
+{
+	IOLog("SWEET A405: resetting GPU core...\n");
+	gpu_write(REG_A4XX_RBBM_SW_RESET_CMD, 1);
+	(void)gpu_read(REG_A4XX_RBBM_SW_RESET_CMD);
+	delay(50);
+	gpu_write(REG_A4XX_RBBM_SW_RESET_CMD, 0);
+	delay(50);
+
+	gpu_write(REG_A4XX_VBIF_ROUND_ROBIN_QOS_ARB, 0x00000003);
+	gpu_write(REG_A4XX_RBBM_GPU_BUSY_MASKED, 0xffffffff);
+	gpu_write(REG_A4XX_RBBM_SP_HYST_CNT, 0x10);
+	gpu_write(REG_A4XX_RBBM_WAIT_IDLE_CLOCKS_CTL, 0x10);
+	gpu_write(REG_A4XX_RBBM_AHB_CTL0, 0x00000001);
+	gpu_write(REG_A4XX_RBBM_AHB_CTL1, 0xa6ffffff);
+	gpu_write(REG_A4XX_RBBM_RBBM_CTL, 0x00000030);
+	gpu_write(REG_A4XX_RBBM_INTERFACE_HANG_INT_CTL, (1 << 30) | 0xffff);
+	gpu_write(REG_A4XX_RB_GMEM_BASE_ADDR, 0);
+	gpu_write(REG_A4XX_RBBM_PERFCTR_CTL, 0x01);
+	gpu_write(REG_A4XX_CP_PERFCTR_CP_SEL_0, 0);
+
+	gpu_write(REG_A4XX_UCHE_TRAP_BASE_LO, 0xffff0000);
+	gpu_write(REG_A4XX_UCHE_TRAP_BASE_HI, 0x0001ffff);
+	gpu_write(REG_A4XX_CP_DEBUG, (1 << 25));
+
+	gpu_write(REG_A4XX_RBBM_SP_REGFILE_SLEEP_CNTL_0, 0x00000441);
+	gpu_write(REG_A4XX_RBBM_SP_REGFILE_SLEEP_CNTL_1, 0x00000441);
+
+	gpu_write(REG_A4XX_CP_PROTECT_CTRL, 0x00000007);
+	gpu_write(REG_A4XX_CP_PROTECT(0), 0x62000010);
+	gpu_write(REG_A4XX_CP_PROTECT(1), 0x63000020);
+	gpu_write(REG_A4XX_CP_PROTECT(2), 0x64000040);
+	gpu_write(REG_A4XX_CP_PROTECT(3), 0x65000080);
+	gpu_write(REG_A4XX_CP_PROTECT(4), 0x66000100);
+	gpu_write(REG_A4XX_CP_PROTECT(5), 0x64000200);
+	gpu_write(REG_A4XX_CP_PROTECT(6), 0x67000800);
+	gpu_write(REG_A4XX_CP_PROTECT(7), 0x64001600);
+	gpu_write(REG_A4XX_CP_PROTECT(8), 0x60003300);
+	gpu_write(REG_A4XX_CP_PROTECT(9), 0x60003800);
+	gpu_write(REG_A4XX_CP_PROTECT(10), 0x61003980);
+	gpu_write(REG_A4XX_CP_PROTECT(11), 0x6e010000);
+
+	gpu_write(REG_A4XX_RBBM_INT_0_MASK, 0);
+
+	/* 8192 words (4096 quadwords) -> ilog2(4096) = 12 = 0x0c */
+	gpu_write(REG_A4XX_CP_RB_CNTL, 0x0000000c | (1 << 27));
+	gpu_write(REG_A4XX_CP_RB_BASE, (uint32_t)g_ring_phys);
+
+	/* Load PM4 ucode */
+	gpu_write(REG_A4XX_CP_ME_RAM_WADDR, 0);
+	for (uint32_t i = 1; i < a420_pm4_fw_len; i++) {
+		gpu_write(REG_A4XX_CP_ME_RAM_DATA, a420_pm4_fw[i]);
+	}
+
+	/* Load PFP ucode */
+	gpu_write(REG_A4XX_CP_PFP_UCODE_ADDR, 0);
+	for (uint32_t i = 1; i < a420_pfp_fw_len; i++) {
+		gpu_write(REG_A4XX_CP_PFP_UCODE_DATA, a420_pfp_fw[i]);
+	}
+
+	gpu_write(REG_A4XX_CP_ME_CNTL, 0);
+
+	/* CP_ME_INIT */
+	ring_out(pm4_pkt3(CP_ME_INIT, 17));
+	ring_out(0x000003f7);
+	ring_out(0x00000000);
+	ring_out(0x00000000);
+	ring_out(0x00000000);
+	ring_out(0x00000080);
+	ring_out(0x00000100);
+	ring_out(0x00000180);
+	ring_out(0x00006600);
+	ring_out(0x00000150);
+	ring_out(0x0000014e);
+	ring_out(0x00000154);
+	ring_out(0x00000001);
+	ring_out(0x00000000);
+	ring_out(0x00000000);
+	ring_out(0x00000000);
+	ring_out(0x00000000);
+	ring_out(0x00000000);
+	ring_flush();
+
+	if (!a4xx_idle()) {
+		IOLog("SWEET A405: CP_ME_INIT timeout\n");
+		return false;
+	}
+
+	IOLog("SWEET A405: Adreno 405 initialized (RB_BASE=0x%llx)\n", g_ring_phys);
+	return true;
+}
+
+extern "C" {
+
+bool hakios_gpu_ready(void) { return g_ready; }
+uint32_t hakios_gpu_last(void) { return g_fence; }
+
+bool hakios_gpu_parameter(uint32_t which, uint64_t *value)
+{
+	switch (which) {
+	case 0x01:
+	case 0x06:
+	case 0x08:
+	case 0x09:
+	case 0x0a:
+	case 0x11:
+	case 0x12:
+	case 0x13:
+		*value = 0;
+		return true;
+	case 0x02:
+		*value = 256 * 1024;
+		return true;
+	case 0x03:
+		*value = 0x04000500ULL;
+		return true;
+	case 0x04:
+		*value = 400000000ULL;
+		return true;
+	case 0x05:
+		*value = mach_absolute_time();
+		return true;
+	case 0x07:
+		*value = 1;
+		return true;
+	case 0x10:
+		*value = 14;
+		return true;
+	default:
+		return false;
+	}
+}
+
+uint64_t hakios_gpu_address(uint64_t size);
+void hakios_gpu_address_free(uint64_t address, uint64_t size);
+bool hakios_gpu_map(uint64_t address, uint64_t phys, bool read_only);
+void hakios_gpu_mapped(void);
+void hakios_gpu_unmap(uint64_t address, uint64_t size);
+void hakios_gpu_to_memory(void *start, uint64_t size);
+uint32_t hakios_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count);
+bool hakios_gpu_done(uint32_t fence);
+
+uint64_t hakios_gpu_address(uint64_t size) { (void)size; return 0; }
+void hakios_gpu_address_free(uint64_t address, uint64_t size) { (void)address; (void)size; }
+bool hakios_gpu_map(uint64_t address, uint64_t phys, bool read_only) { (void)address; (void)phys; (void)read_only; return true; }
+void hakios_gpu_mapped(void) {}
+void hakios_gpu_unmap(uint64_t address, uint64_t size) { (void)address; (void)size; }
+void hakios_gpu_to_memory(void *start, uint64_t size) { flush_dcache64((uint64_t)start, (unsigned)size, 0); }
+
+uint32_t hakios_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	if (!g_ready || count == 0) return 0;
+
+	for (uint32_t i = 0; i < count; i++) {
+		ring_out(pm4_pkt3(CP_INDIRECT_BUFFER_PFE, 2));
+		ring_out((uint32_t)addresses[i]);
+		ring_out(words[i]);
+		ring_out(pm4_pkt2());
+	}
+
+	if (++g_fence == 0) g_fence = 1;
+
+	ring_out(pm4_pkt0(REG_AXXX_CP_SCRATCH_REG2, 1));
+	ring_out(g_fence);
+	ring_out(pm4_pkt3(CP_EVENT_WRITE, 1));
+	ring_out(HLSQ_FLUSH);
+	ring_out(pm4_pkt3(CP_WAIT_FOR_IDLE, 1));
+	ring_out(pm4_pkt3(CP_EVENT_WRITE, 1));
+	ring_out(CACHE_FLUSH_TS);
+	ring_flush();
+	return g_fence;
+}
+
+bool hakios_gpu_done(uint32_t fence)
+{
+	if (!g_ready) return true;
+	uint32_t cur = gpu_read(REG_AXXX_CP_SCRATCH_REG2);
+	return (int32_t)(cur - fence) >= 0;
+}
