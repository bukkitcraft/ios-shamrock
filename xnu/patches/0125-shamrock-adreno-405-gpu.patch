+
+static IOLock *gGPULock;
+
+class HakiosGPUUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(HakiosGPUUserClient);
+
+private:
+	task_t fTask;
+	struct gpu_buffer *fBuffers;
+	uint32_t fNextBuffer;
+
+	struct gpu_buffer *buffer(uint32_t handle) {
+		if (handle == 0 || handle > GPU_BUFFERS || fBuffers == NULL) return NULL;
+		struct gpu_buffer *b = &fBuffers[handle - 1];
+		return b->memory != NULL ? b : NULL;
+	}
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties) APPLE_KEXT_OVERRIDE {
+		if (!IOUserClient::initWithTask(owningTask, securityID, type, properties)) return false;
+		fTask = owningTask;
+		return true;
+	}
+
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE {
+		if (!hakios_gpu_ready() || !IOUserClient::start(provider)) return false;
+		fBuffers = (struct gpu_buffer *)IOMallocZero(sizeof(struct gpu_buffer) * GPU_BUFFERS);
+		return fBuffers != NULL;
+	}
+
+	IOReturn clientClose() APPLE_KEXT_OVERRIDE {
+		terminate();
+		return kIOReturnSuccess;
+	}
+
+	void free() APPLE_KEXT_OVERRIDE {
+		if (fBuffers) {
+			for (uint32_t i = 0; i < GPU_BUFFERS; i++) {
+				if (fBuffers[i].memory) {
+					if (fBuffers[i].surface) fBuffers[i].surface->release();
+					else fBuffers[i].memory->release();
+				}
+			}
+			IOFree(fBuffers, sizeof(struct gpu_buffer) * GPU_BUFFERS);
+			fBuffers = NULL;
+		}
+		IOUserClient::free();
+	}
+
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE {
+		IOLockLock(gGPULock);
+		struct gpu_buffer *b = buffer(type);
+		if (b == NULL || b->memory == NULL) {
+			IOLockUnlock(gGPULock);
+			return kIOReturnBadArgument;
+		}
+		*memory = b->memory;
+		(*memory)->retain();
+		*options = kIOMapAnywhere;
+		IOLockUnlock(gGPULock);
+		return kIOReturnSuccess;
+	}
+
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(HakiosGPUUserClient, IOUserClient);
+
+IOReturn
+HakiosGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference)
+{
+	(void)dispatch; (void)target; (void)reference;
+	if (!args->structureInput || !fBuffers) return kIOReturnBadArgument;
+	if (!hakios_gpu_ready()) return kIOReturnNotReady;
+
+	switch (selector) {
+	case kMsmGetParam: {
+		struct { uint32_t param; uint32_t pad; uint64_t value; } p;
+		memcpy(&p, args->structureInput, sizeof(p));
+		bool ok = hakios_gpu_parameter(p.param, &p.value);
+		if (ok && args->structureOutput && args->structureOutputSize >= sizeof(p)) {
+			memcpy(args->structureOutput, &p, sizeof(p));
+			return kIOReturnSuccess;
+		}
+		return ok ? kIOReturnSuccess : kIOReturnBadArgument;
+	}
+	case kMsmGemNew: {
+		struct msm_gem_new req;
+		memcpy(&req, args->structureInput, sizeof(req));
+		uint64_t size = (req.size + 4095) & ~4095ULL;
+		IOBufferMemoryDescriptor *mem = IOBufferMemoryDescriptor::inTaskWithOptions(
+		    kernel_task, kIODirectionInOut | kIOMemoryKernelUserShared, (vm_size_t)size, PAGE_SIZE);
+		if (!mem) return kIOReturnNoMemory;
+		bzero(mem->getBytesNoCopy(), (size_t)size);
+
+		IOLockLock(gGPULock);
+		uint32_t h = (fNextBuffer++) % GPU_BUFFERS;
+		struct gpu_buffer *b = &fBuffers[h];
+		b->memory = mem;
+		b->kernel = (uint8_t *)mem->getBytesNoCopy();
+		b->phys = kvtophys((uint64_t)b->kernel);
+		b->size = size;
+		b->surface = NULL;
+		req.handle = h + 1;
+		IOLockUnlock(gGPULock);
+
+		if (args->structureOutput && args->structureOutputSize >= sizeof(req)) {
+			memcpy(args->structureOutput, &req, sizeof(req));
+		}
+		return kIOReturnSuccess;
+	}
+	case kMsmGemInfo: {
+		struct msm_gem_info info;
+		memcpy(&info, args->structureInput, sizeof(info));
+		IOLockLock(gGPULock);
+		struct gpu_buffer *b = buffer(info.handle);
+		if (!b) { IOLockUnlock(gGPULock); return kIOReturnBadArgument; }
+		if (info.info == MSM_INFO_GET_OFFSET) info.value = info.handle;
+		else if (info.info == MSM_INFO_GET_IOVA) info.value = b->phys;
+		IOLockUnlock(gGPULock);
+		if (args->structureOutput && args->structureOutputSize >= sizeof(info)) {
+			memcpy(args->structureOutput, &info, sizeof(info));
+		}
+		return kIOReturnSuccess;
+	}
+	case kMsmGemCpuPrep:
+	case kMsmGemCpuFini:
+		return kIOReturnSuccess;
+	case kMsmGemSubmit: {
+		struct msm_gem_submit req;
+		memcpy(&req, args->structureInput, sizeof(req));
+		if (req.nr_cmds > 16) return kIOReturnBadArgument;
+		struct msm_gem_submit_cmd cmds[16];
+		if (copyin((user_addr_t)req.cmds, cmds, req.nr_cmds * sizeof(cmds[0])) != 0) {
+			return kIOReturnBadArgument;
+		}
+
+		uint64_t addrs[16];
+		uint32_t words[16];
+		IOLockLock(gGPULock);
+		for (uint32_t i = 0; i < req.nr_cmds; i++) {
+			struct gpu_buffer *b = buffer(cmds[i].submit_idx + 1);
+			addrs[i] = b ? (b->phys + cmds[i].submit_offset) : 0;
+			words[i] = cmds[i].size / 4;
+		}
+		req.fence = hakios_gpu_submit(addrs, words, req.nr_cmds);
+		IOLockUnlock(gGPULock);
+
+		if (args->structureOutput && args->structureOutputSize >= sizeof(req)) {
+			memcpy(args->structureOutput, &req, sizeof(req));
+		}
+		return kIOReturnSuccess;
+	}
+	case kMsmWaitFence: {
+		struct msm_wait_fence w;
+		memcpy(&w, args->structureInput, sizeof(w));
+		for (int i = 0; i < 5000; i++) {
+			if (hakios_gpu_done(w.fence)) return kIOReturnSuccess;
+			delay(100);
+		}
+		return kIOReturnTimeout;
+	}
+	case kHakiosSurface: {
+		struct hakios_surface sreq;
+		memcpy(&sreq, args->structureInput, sizeof(sreq));
+		SweetSurface *s = sweet_surface_copy(sreq.surface);
+		if (!s) return kIOReturnNotFound;
+
+		sreq.size = s->allocSize ? s->allocSize : (s->height * s->bytesPerRow);
+		sreq.offset = s->offset;
+		sreq.rowBytes = s->bytesPerRow;
+		sreq.width = s->width;
+		sreq.height = s->height;
+		sreq.pixelFormat = s->pixelFormat;
+		sreq.planes = 1;
+
+		if (sreq.handle == kHakiosDescribe) {
+			s->release();
+			if (args->structureOutput && args->structureOutputSize >= sizeof(sreq)) {
+				memcpy(args->structureOutput, &sreq, sizeof(sreq));
+			}
+			return kIOReturnSuccess;
+		}
+
+		IOLockLock(gGPULock);
+		uint32_t h = (fNextBuffer++) % GPU_BUFFERS;
+		struct gpu_buffer *b = &fBuffers[h];
+		b->memory = s->memory;
+		b->kernel = (uint8_t *)s->kernelAddress();
+		b->phys = kvtophys((uint64_t)b->kernel);
+		b->size = sreq.size;
+		b->surface = s;
+		sreq.handle = h + 1;
+		IOLockUnlock(gGPULock);
+
+		if (args->structureOutput && args->structureOutputSize >= sizeof(sreq)) {
+			memcpy(args->structureOutput, &sreq, sizeof(sreq));
+		}
+		return kIOReturnSuccess;
+	}
+	case kDrmGemClose: {
+		struct drm_gem_close cl;
+		memcpy(&cl, args->structureInput, sizeof(cl));
+		IOLockLock(gGPULock);
+		struct gpu_buffer *b = buffer(cl.handle);
+		if (b) {
+			if (b->surface) b->surface->release();
+			else if (b->memory) b->memory->release();
+			bzero(b, sizeof(*b));
+		}
+		IOLockUnlock(gGPULock);
+		return kIOReturnSuccess;
+	}
+	default:
+		return kIOReturnSuccess;
+	}
+}
+
+class HakiosGPU : public IOService {
+	OSDeclareDefaultStructors(HakiosGPU);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(HakiosGPU, IOService);
+
+bool
+HakiosGPU::start(IOService *provider)
+{
+	if (!IOService::start(provider)) return false;
+
+	int gpu_enabled = 0;
+	PE_parse_boot_argn("sweetgpu", &gpu_enabled, sizeof(gpu_enabled));
+	if (!gpu_enabled) {
+		IOLog("SWEET A405: disabled (pass sweetgpu=1 in boot-args to enable)\n");
+		return false;
+	}
+
+	IOLog("SWEET A405: initializing Qualcomm Adreno 405...\n");
+
+	g_gcc = (volatile uint32_t *)ml_io_map(SHAMROCK_GCC_PA, 0x60000);
+	g_gpu = (volatile uint32_t *)ml_io_map(SHAMROCK_GPU_PA, 0x10000);
+
+	if (!g_gcc || !g_gpu) {
+		IOLog("SWEET A405: failed to map MMIO registers\n");
+		return false;
+	}
+
+	static uint32_t s_rb[RING_WORDS] __attribute__((aligned(4096)));
+	g_ring = s_rb;
+	g_ring_phys = kvtophys((uint64_t)g_ring);
+	gGPULock = IOLockAlloc();
+
+	if (!power_on_oxili() || !a4xx_hw_init()) {
+		IOLog("SWEET A405: hardware initialization failed\n");
+		return false;
+	}
+
+	g_ready = true;
+	setProperty(kIOUserClientClassKey, "HakiosGPUUserClient");
+	setName("HakiosGPU");
+	registerService();
+	IOLog("SWEET A405: HakiosGPU service registered successfully!\n");
+	return true;
+}
+
+#endif /* SWEET */
