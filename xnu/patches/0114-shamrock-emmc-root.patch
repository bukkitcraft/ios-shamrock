--- c/iokit/bsddev/IOKitBSDInit.cpp
+++ w/iokit/bsddev/IOKitBSDInit.cpp
@@ -770,6 +770,18 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 //
 //	SWEET: root on a GPT partition of the internal UFS (bsd/dev/sweet_ufs.c)
 //
+	if (strcmp(rdBootVar, "emmcroot0") == 0) {
+		extern int sweet_emmc_rootdev(dev_t *dev);
+		OSSafeReleaseNULL(matching);
+		int emmc_error = sweet_emmc_rootdev(root);
+		if (emmc_error) {
+			panic("IOFindBSDRoot: SWEET eMMC root %s unavailable: %d", rdBootVar, emmc_error);
+		}
+		strlcpy(rootName, rdBootVar, rootNameSize);
+		IOLog("BSD root: %s, major %d, minor %d\n", rootName, major(*root), minor(*root));
+		*oflags = 0;
+		goto iofrootx;
+	}
 	if (strcmp(rdBootVar, "ufsroot0") == 0) {
 		extern int sweet_ufs_rootdev(dev_t *dev);
 		OSSafeReleaseNULL(matching);
