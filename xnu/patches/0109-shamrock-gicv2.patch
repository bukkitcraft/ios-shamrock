 #define __ARM64_PMAP_SUBPAGE_L1__ 1
 
-#define HAS_GIC_V3                1
+/* shamrock: MSM8952 has a GIC-400 (GICv2, no ICC_* system registers) */
+#define HAS_GIC_V2                1
+
+#define SWEET_GICD_CTLR           0x000
+#define SWEET_GICD_ISENABLER0     0x100
+#define SWEET_GICD_IPRIORITYR0    0x400
+#define SWEET_GICD_ITARGETSR0     0x800
+#define SWEET_GICD_SGIR           0xF00
+#define SWEET_GICC_CTLR           0x000
+#define SWEET_GICC_PMR            0x004
+#define SWEET_GICC_BPR            0x008
+#define SWEET_GICC_IAR            0x00C
+#define SWEET_GICC_EOIR           0x010
 
 /* shamrock: 4K pages -> 2MB L2 blocks; the early framebuffer needs several (QEMU 1080x2400x4 = 10.4MB -> 6) */
 #define SWEET_EARLY_FB_BLOCKS     6
