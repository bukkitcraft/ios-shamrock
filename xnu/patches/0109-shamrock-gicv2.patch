diff --git c/iokit/Kernel/arm/SweetCPU.cpp w/iokit/Kernel/arm/SweetCPU.cpp
index 2545cf9..594440d 100644
--- c/iokit/Kernel/arm/SweetCPU.cpp
+++ w/iokit/Kernel/arm/SweetCPU.cpp
@@ -206,6 +206,13 @@ SweetCPU::initCPU(bool boot)
 	__atomic_store_n(&initialized, 1, __ATOMIC_RELEASE);
 }
 
+#if HAS_GIC_V2
+extern "C" {
+extern vm_offset_t sweet_gicd_base;
+extern uint8_t sweet_gic_cpu_target[16];
+}
+#endif
+
 void
 SweetCPU::signalCPU(IOCPU *target)
 {
@@ -214,6 +221,20 @@ SweetCPU::signalCPU(IOCPU *target)
 	if (logical >= topology->num_cpus) {
 		panic("SWEET CPU: invalid SGI target %u", logical);
 	}
+#if HAS_GIC_V2
+	{
+		uint64_t m = topology->cpus[logical].phys_id;
+		/* measured mask if the target already initialised its GIC interface, else Aff1*4+Aff0 (to be verified on the phone) */
+		uint32_t tm = logical < sizeof(sweet_gic_cpu_target) ? sweet_gic_cpu_target[logical] : 0;
+		if (tm == 0) {
+			tm = 1U << ((((m >> 8) & 0xff) * 4 + (m & 0xff)) & 7);
+		}
+		__builtin_arm_dsb(DSB_ISHST);
+		*(volatile uint32_t *)(sweet_gicd_base + SWEET_GICD_SGIR) = (tm << 16) | (1U << 15) | SWEET_IPI_SGI;
+		__builtin_arm_dsb(DSB_SY);
+		return;
+	}
+#endif
 	/* Use the TARGET affinity, including Aff1, never the sender's MPIDR. */
 	uint64_t mpidr = topology->cpus[logical].phys_id;
 	unsigned int aff0 = mpidr & 0xff;
diff --git c/osfmk/arm64/sleh.c w/osfmk/arm64/sleh.c
index b8be8df..d341ace 100644
--- c/osfmk/arm64/sleh.c
+++ w/osfmk/arm64/sleh.c
@@ -1858,8 +1858,16 @@ sleh_irq(arm_saved_state_t *state)
 	 * sweet: TrustZone owns GIC Group 0, so the timer and IPIs that other
 	 * ARM64 targets take as FIQs arrive here as Group 1 IRQs.
 	 */
+#if HAS_GIC_V2
+	extern vm_offset_t sweet_gicc_base;
+	uint64_t iar = *(volatile uint32_t *)(sweet_gicc_base + SWEET_GICC_IAR);
+	uint32_t intid = (uint32_t)(iar & 0x3FF);
+#define SWEET_GIC_EOI(v) (*(volatile uint32_t *)(sweet_gicc_base + SWEET_GICC_EOIR) = (uint32_t)(v))
+#else
 	uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
 	uint32_t intid = (uint32_t)(iar & 0xFFFFFF);
+#define SWEET_GIC_EOI(v) __builtin_arm_wsr64("ICC_EOIR1_EL1", (v))
+#endif
 
 	if (intid >= 1020 && intid <= 1023) {
 		return; /* spurious */
@@ -1870,11 +1878,11 @@ sleh_irq(arm_saved_state_t *state)
 		INTERRUPT_MASKED_DEBUG_START(rtclock_intr, DBG_INTR_TYPE_TIMER);
 		rtclock_intr(TRUE);
 		INTERRUPT_MASKED_DEBUG_END();
-		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+		SWEET_GIC_EOI(iar);
 	} else if (intid < 16) {
 		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_IPI);
 		/* Ack before handling so an IPI raised meanwhile is not lost */
-		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+		SWEET_GIC_EOI(iar);
 		__builtin_arm_isb(ISB_SY);
 		cpu_signal_handler();
 	} else {
@@ -1885,7 +1893,7 @@ sleh_irq(arm_saved_state_t *state)
 			    cdp->interrupt_nub,
 			    intid);
 		}
-		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+		SWEET_GIC_EOI(iar);
 	}
 	__builtin_arm_isb(ISB_SY);
 #else
diff --git c/pexpert/arm/pe_fiq.c w/pexpert/arm/pe_fiq.c
index 6089db9..37ffd29 100644
--- c/pexpert/arm/pe_fiq.c
+++ w/pexpert/arm/pe_fiq.c
@@ -222,6 +222,75 @@ pe_init_fiq()
 	__builtin_arm_isb(ISB_SY);
 #endif /* SWEET */
 }
+#elif HAS_GIC_V2
+/* shamrock: GICv2 (GIC-400). /arm-io/gic "reg" = { GICD base, GICD size, GICC base, GICC size } like the v3 layout. */
+SECURITY_READ_ONLY_LATE(uint32_t) sweet_vtimer_intid = SWEET_VTIMER_INTID;
+vm_offset_t sweet_gicd_base;
+vm_offset_t sweet_gicc_base;
+uint8_t sweet_gic_cpu_target[16];       /* GICD target-list bit of each logical CPU, measured at init */
+
+#define sgicd32(off) (*(volatile uint32_t *)(sweet_gicd_base + (off)))
+#define sgicc32(off) (*(volatile uint32_t *)(sweet_gicc_base + (off)))
+
+void
+pe_init_fiq()
+{
+	bool boot_cpu = false;
+
+	if (!sweet_gicd_base) {
+		boot_cpu = true;
+		DTEntry entry;
+		if (SecureDTLookupEntry(NULL, "/arm-io/gic", &entry) != kSuccess) {
+			panic("%s: cannot find GIC node in DT", __func__);
+		}
+		void const *prop;
+		unsigned int prop_size;
+		if (SecureDTGetProperty(entry, "reg", &prop, &prop_size) != kSuccess || prop_size < 4 * sizeof(uint64_t)) {
+			panic("%s: bad GIC reg property", __func__);
+		}
+		void const *timer_prop;
+		unsigned int timer_size;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &timer_size) == kSuccess &&
+		    timer_size == sizeof(uint32_t)) {
+			uint32_t intid = *(const uint32_t *)timer_prop;
+			if (intid < 16 || intid >= 32) {
+				panic("%s: virtual timer INTID %u is not a PPI", __func__, intid);
+			}
+			sweet_vtimer_intid = intid;
+		}
+		kprintf("SWEET GICv2: virtual timer INTID %u\n", sweet_vtimer_intid);
+
+		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+		uint64_t const *regs = (uint64_t const *)prop;
+		vm_offset_t gicc = ml_io_map(soc_base_phys + regs[2], regs[3]);
+		vm_offset_t gicd = ml_io_map(soc_base_phys + regs[0], regs[1]);
+		if (!gicd || !gicc) {
+			panic("%s: cannot map GICD/GICC", __func__);
+		}
+		sweet_gicc_base = gicc;
+		sweet_gicd_base = gicd;
+	}
+
+	/* GICD_ITARGETSR0..7 are banked and read-only for SGI/PPI: they read as this CPU's own interface mask. */
+	uint32_t me = sgicd32(SWEET_GICD_ITARGETSR0) & 0xff;
+	unsigned int cpu = ml_get_cpu_number_local();
+	if (cpu < sizeof(sweet_gic_cpu_target)) {
+		sweet_gic_cpu_target[cpu] = (uint8_t)me;
+	}
+	kprintf("SWEET GICv2: cpu %u target mask 0x%x\n", cpu, me);
+
+	for (unsigned int i = 0; i < 32; i += 4) {
+		sgicd32(SWEET_GICD_IPRIORITYR0 + i) = 0xA0A0A0A0;
+	}
+	sgicd32(SWEET_GICD_ISENABLER0) = (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI);
+	sgicc32(SWEET_GICC_PMR) = 0xFF;
+	sgicc32(SWEET_GICC_BPR) = 0;
+	sgicc32(SWEET_GICC_CTLR) = 1;           /* EnableGrp1 (non-secure view), EOImode 0 */
+	if (boot_cpu) {
+		sgicd32(SWEET_GICD_CTLR) = sgicd32(SWEET_GICD_CTLR) | 1;
+	}
+	__builtin_arm_dsb(DSB_SY);
+}
 #else
 void
 pe_init_fiq()
