+/*
+ * shamrock: a GEM buffer whose pages are really write-combined. kIOMapWriteCombineCache on an
+ * IOBufferMemoryDescriptor only sets the cache mode of later mappings; the pages stayed
+ * cacheable where it mattered and the GPU read stale lines of what Mesa wrote (speckles in the
+ * clock's glyphs, noise under the dock). As ios-river 0192: set the pages' own cache attribute
+ * (pmap_set_cache_attributes, every mapping follows) once they are clean, and give it back
+ * before they return to the VM.
+ */
+extern "C" void pmap_set_cache_attributes(ppnum_t pn, unsigned int cacheattr);
+extern "C" ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern "C" const pmap_t kernel_pmap;
+#define HAKIOS_WIMG_WCOMB       0x6     /* VM_WIMG_WCOMB (osfmk/arm/memory_types.h) */
+#define HAKIOS_WIMG_DEFAULT     0x2     /* VM_WIMG_DEFAULT */
+
+class HakiosGPUMemory : public IOBufferMemoryDescriptor
+{
+	OSDeclareDefaultStructors(HakiosGPUMemory);
+public:
+	static HakiosGPUMemory * make(IOOptionBits options, vm_size_t size);
+protected:
+	virtual void free() APPLE_KEXT_OVERRIDE;
+private:
+	void setPagesCache(unsigned int wimg);
+	bool fUncached;
+};
+
+OSDefineMetaClassAndStructors(HakiosGPUMemory, IOBufferMemoryDescriptor);
+
+void
+HakiosGPUMemory::setPagesCache(unsigned int wimg)
+{
+	uint8_t * va = (uint8_t *) getBytesNoCopy();
+
+	for (vm_size_t o = 0; va != NULL && o < getCapacity(); o += PAGE_SIZE) {
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)(uintptr_t)(va + o));
+		if (pn != 0) {
+			pmap_set_cache_attributes(pn, wimg);
+		}
+	}
+}
+
+HakiosGPUMemory *
+HakiosGPUMemory::make(IOOptionBits options, vm_size_t size)
+{
+	HakiosGPUMemory * m = OSTypeAlloc(HakiosGPUMemory);
+
+	if (m == NULL || !m->initWithPhysicalMask(kernel_task, options, size, PAGE_SIZE, 0)) {
+		OSSafeReleaseNULL(m);
+		return NULL;
+	}
+	/* (zeroed through the cached kernel view: out of the cache first, then uncached for good) */
+	flush_dcache64((addr64_t)(uintptr_t)m->getBytesNoCopy(), (unsigned) size, FALSE);
+	m->setPagesCache(HAKIOS_WIMG_WCOMB);
+	m->fUncached = true;
+	return m;
+}
+
+void
+HakiosGPUMemory::free()
+{
+	if (fUncached) {
+		setPagesCache(HAKIOS_WIMG_DEFAULT);
+		fUncached = false;
+	}
+	IOBufferMemoryDescriptor::free();
+}
