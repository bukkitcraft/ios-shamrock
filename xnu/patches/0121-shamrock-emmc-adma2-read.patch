 } se;
 
+#define DMA_TABLE       0x0000          /* ADMA2 descriptors, 16 x 8 bytes used */
+#define DMA_BOUNCE      0x4000
+#define DMA_BYTES       (1u << 20)      /* bounce size: 2048 sectors */
+#define DMA_ALLOC       (DMA_BOUNCE + DMA_BYTES)
+
 /* init log kept in RAM; on failure it is copied to 0xbff40000 (SWEETDUMP format) and the SoC is reset by the watchdog so lk2nd can read it */
