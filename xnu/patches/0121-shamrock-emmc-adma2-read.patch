 }
 
+/* Multi-block read (CMD18) with ADMA2 into the bounce buffer; count <= DMA_BYTES / 512. */
+static int
+emmc_dma_read(uint32_t lba, uint32_t count)
+{
+	struct { uint16_t attr; uint16_t len; uint32_t addr; } *d = (void *)(se.dma + DMA_TABLE);
+	uint32_t bytes = count * 512, n = 0, off = 0;
+	uint64_t t0;
+
+	while (off < bytes) {
+		uint32_t l = MIN(bytes - off, 0x10000u);
+		d[n].attr = 0x21;               /* valid, act = tran */
+		d[n].len = (uint16_t)l;         /* 0 means 64 KiB */
+		d[n].addr = (uint32_t)(se.dma_pa + DMA_BOUNCE + off);
+		off += l;
+		n++;
+	}
+	d[n - 1].attr = 0x23;                   /* valid, end, tran */
+	flush_dcache64((addr64_t)(se.dma_pa + DMA_TABLE), n * 8, TRUE);
+	flush_dcache64((addr64_t)(se.dma_pa + DMA_BOUNCE), bytes, TRUE);
+
+	t0 = mach_absolute_time();
+	hw(0x2c, hr(0x2c) | (0x06u << 24));
+	while (((hr(0x2c) >> 24) & 6) && !timed_out(t0, 100000)) {
+	}
+	t0 = mach_absolute_time();
+	while (hr(0x24) & 3) {
+		if (timed_out(t0, 100000)) {
+			return -1;
+		}
+	}
+	hw(0x34, 0x0000ffff);
+	hw(0x30, 0xffffffff);
+	hw(0x28, (hr(0x28) & ~0x18u) | 0x10);   /* DMA select: ADMA2 32-bit */
+	hw(0x58, (uint32_t)(se.dma_pa + DMA_TABLE));
+	hw(0x5c, (uint32_t)((se.dma_pa + DMA_TABLE) >> 32));
+	hw(0x04, (count << 16) | 512 | (7 << 12));
+	hw(0x08, lba);
+	/* CMD18, R1; transfer mode: DMA | block count | auto CMD12 | read | multi block */
+	hw(0x0c, (((18u << 8) | 0x3a) << 16) | 0x0037);
+	t0 = mach_absolute_time();
+	for (;;) {
+		uint32_t st = hr(0x30);
+		if (st & 0x8000) {
+			last_int = st;
+			cmd_reset();
+			return -2;
+		}
+		if (st & 2) {
+			break;
+		}
+		if (timed_out(t0, 3000000)) {
+			last_int = st;
+			cmd_reset();
+			return -3;
+		}
+	}
+	hw(0x30, 0xffffffff);
+	flush_dcache64((addr64_t)(se.dma_pa + DMA_BOUNCE), bytes, TRUE);
+	return 0;
+}
